---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/cards/CaseCard.astro';
import { caseStudies } from '../../data/case-studies';
---

<BaseLayout title="Case Studies">
	<h1>Case Studies</h1>
	<p class="dek">Each told as context, challenge, actions and results.</p>

	<ul data-ui class="cards flex flex-col gap-gutter">
		{
			caseStudies.map((c) => (
				<li>
					<CaseCard c={c} />
				</li>
			))
		}
	</ul>
</BaseLayout>

<style>
	.dek {
		max-width: 42rem;
		color: var(--color-text-muted);
		margin-top: var(--space-2);
	}

	.cards {
		margin-top: var(--space-title);
	}
</style>
