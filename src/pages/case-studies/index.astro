---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndexRow from '../../components/ui/IndexRow.astro';
import { withBase } from '../../lib/base';
import { caseStudies } from '../../data/case-studies';
---

<BaseLayout title="Case Studies">
	<h1>Case Studies</h1>
	<p class="dek">Real work, each in context, challenge, actions and results.</p>

	<ol data-ui class="rows">
		{
			caseStudies.map((c) => (
				<IndexRow
					href={withBase(`case-studies/${c.slug}/`)}
					title={c.title}
					body={c.challenge}
					label={`Real work · ${c.role} · ${c.org} · ${c.years}`}
					mark={c.mark}
				/>
			))
		}
	</ol>
</BaseLayout>

<style>
	.dek {
		max-width: 42rem;
		color: var(--color-text-muted);
		margin-top: var(--space-2);
	}

	.rows {
		margin-top: var(--space-title);
	}
</style>
