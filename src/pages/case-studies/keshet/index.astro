---
// Case study 01. Copy lives in src/data/case-studies.ts; the artifacts below
// are this engagement's charts and diagrams.
import CaseStudyPage from '../../../components/CaseStudyPage.astro';
import IntakeFlowDiagram from '../../../components/charts/IntakeFlowDiagram.astro';
import UseCaseMaturityStat from '../../../components/charts/UseCaseMaturityStat.astro';
import LicenseTierChart from '../../../components/charts/LicenseTierChart.astro';
import CopilotChart from '../../../components/charts/CopilotChart.astro';
import { withBase } from '../../../lib/base';
---

<CaseStudyPage slug="keshet">
	<section>
		<h3>Artifacts</h3>
		<p>
			The request flow before and after the intake path, the scale of the AI use-case mapping alongside the maturity
			model, and the license picture behind the unified AI tool licensing. A fully built, generalized version of the
			intake system is the flagship coded project on this site:
			<a href={withBase('projects/ai-intake-governance-agent/')}>AI Project Intake &amp; Governance Agent</a>.
		</p>
		<IntakeFlowDiagram />
		<UseCaseMaturityStat />
		<div class="chart-row">
			<LicenseTierChart />
			<CopilotChart />
		</div>
	</section>
</CaseStudyPage>

<style>
	.chart-row {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-5);
		margin-top: var(--space-3);
	}
</style>
