---
// How I work: the operating profile, tools, and education. Deliberately no
// executive summary or pillars (those are on the homepage) and no steering
// committee (case study 01), so nothing here repeats. Copy: src/data/about.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import Label from '../../components/ui/Label.astro';
import Rule from '../../components/ui/Rule.astro';
import ArrowLink from '../../components/ui/ArrowLink.astro';
import Icon from '../../components/Icon.astro';
import { person } from '../../data/home';
import { profile, tools, education, trainingNote, languages, testimonials } from '../../data/about';
import { withBase } from '../../lib/base';

const attributed = testimonials.filter((t) => t.name.trim() && t.title.trim());
---

<BaseLayout title="How I work" description="Leadership style, delivery methodologies, domain specialization, tools and education.">
	<div data-ui class="flex flex-col gap-section">
		<header class="flex flex-col gap-stack">
			<div data-shape-in><Icon name="quarter" size="xl" tone="mark" /></div>
			<h1 class="font-display text-3xl leading-display tracking-display">How I work</h1>
			<p class="max-w-2xl text-lg text-ink-muted">The way I lead, the methods I rely on, and the domains I know best.</p>
			<div class="flex flex-wrap gap-x-stack gap-y-gutter">
				<ArrowLink href={withBase(person.resume)}>Download résumé</ArrowLink>
				<ArrowLink href="#contact">Get in touch</ArrowLink>
			</div>
		</header>

		<section aria-labelledby="profile-heading" class="flex flex-col gap-title">
			<div id="profile-heading"><SectionHead index="01" title="Operating profile" mark="half" /></div>
			{/* Three columns divided by hairlines, each item ruled: a grid without boxes. */}
			<div class="grid gap-stack md:grid-cols-3 md:gap-0">
				{
					profile.map((col, i) => (
						<div class:list={['flex flex-col', i > 0 && 'md:border-l md:border-ink-rule md:pl-gutter', i < 2 && 'md:pr-gutter']}>
							<Label class="flex items-center gap-tight pb-gutter text-ink-muted">
								<Icon name={col.mark} size="md" tone="mark" />
								{col.heading}
							</Label>
							<ul>
								{col.items.map((item) => (
									<li data-reveal class="relative flex flex-col gap-tight py-stack">
										<Rule />
										<h3 class="font-display text-xl leading-title tracking-display">{item.lead}</h3>
										<p class="text-base text-ink-muted">{item.text}</p>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</section>

		<section aria-labelledby="tools-heading" class="flex flex-col gap-title">
			<div id="tools-heading"><SectionHead index="02" title="Tools & stack" mark="circle" /></div>
			<ul>
				{
					tools.map((g) => (
						<li
							data-reveal
							class="group relative flex flex-col gap-tight py-stack md:flex-row md:items-center md:justify-between md:gap-stack"
						>
							<Rule />
							<h3 class="flex shrink-0 items-center gap-gutter font-display text-xl tracking-display">
								<Icon name={g.mark} size="lg" tone="mark" class="transition-transform duration-fast ease-out group-hover:rotate-90" />
								{g.title}
							</h3>
							<ul class="flex flex-wrap items-center gap-tight text-base text-ink-muted md:justify-end">
								{g.items.map((item, i) => (
									<li class="flex items-center gap-tight">
										{i > 0 && <span aria-hidden="true" class="size-dot rounded-full bg-ink" />}
										{item}
									</li>
								))}
							</ul>
						</li>
					))
				}
			</ul>
		</section>

		<section aria-labelledby="education-heading" class="flex flex-col gap-title">
			<div id="education-heading"><SectionHead index="03" title="Education & certifications" mark="leaf" /></div>
			<ul>
				{
					education.map((e) => (
						<li data-reveal class="relative flex flex-col gap-tight py-stack md:flex-row md:items-center md:justify-between">
							<Rule />
							<h3 class="flex items-center gap-gutter font-display text-xl tracking-display">
								<Icon name={e.mark} size="lg" tone="mark" />
								{e.title}
							</h3>
							<Label class="text-ink-muted">{e.detail}</Label>
						</li>
					))
				}
			</ul>
			<div class="flex flex-col gap-tight">
				<Label>{trainingNote}</Label>
				<Label class="text-ink-muted">Languages: {languages}</Label>
			</div>
		</section>

		{
			attributed.length > 0 && (
				<section aria-labelledby="testimonials-heading" class="flex flex-col gap-title">
					<div id="testimonials-heading">
						<SectionHead index="04" title="What people say" mark="quarter" />
					</div>
					<ul class="grid gap-stack md:grid-cols-3 md:gap-gutter">
						{attributed.map((t) => (
							<li data-reveal class="relative flex flex-col gap-gutter pt-stack">
								<Rule />
								<blockquote class="font-serif text-xl leading-title">“{t.quote}”</blockquote>
								<Label>
									{t.name}, {t.title} · {t.org}
								</Label>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</div>
</BaseLayout>
