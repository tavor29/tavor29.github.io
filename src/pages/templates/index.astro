---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndexRow from '../../components/ui/IndexRow.astro';
import { withBase } from '../../lib/base';
import { person } from '../../data/home';
import { contactGated } from '../../data/services';

const docs = (await getCollection('templates')).sort((a, b) => a.data.order - b.data.order);

// Tools built in real roles. Sanitized previews aren't published yet, so these
// link to an email request; swap the href for a page once a preview exists.
const realTools: { title: string; body: string; mark: 'half' | 'quarter' | 'circle' | 'leaf' }[] = [
	{
		title: 'Executive Budget & Milestone KPI Tracker (SQL + Tableau)',
		body: 'Automated dashboard for tracking multi-million-dollar program spend, milestone risk, and long-lead bottlenecks in real time.',
		mark: 'quarter',
	},
	{
		title: 'Shadow AI Intake & Compliance Matrix',
		body: 'A standard framework for evaluating AI tools on data privacy, API security, cost, and architecture fit.',
		mark: 'half',
	},
	{
		title: 'Long-Lead Procurement & BOM Tracker',
		body: 'Links R&D specifications to vendor lead times, PO approvals, and site delivery handoffs.',
		mark: 'quarter',
	},
];
---

<BaseLayout title="Templates & Docs" description="Working templates and worked examples: pilot readiness, license audits, one-page PRDs, decision memos and prioritization.">
	<h1>Templates &amp; Docs</h1>
	<p class="dek">
		Working documents I use to turn ad hoc decisions into repeatable ones. Each one opens as a page and downloads as an
		editable file.
	</p>

	<ol data-ui class="rows">
		{
			docs.map((d) => (
				<IndexRow
					href={withBase(`templates/${d.id}/`)}
					title={d.data.title}
					body={d.data.summary}
					label={d.data.kind}
					mark={d.data.mark}
					real={d.data.origin !== 'fictional'}
				/>
			))
		}
		{
			realTools.map((t) => (
				<IndexRow
					href={contactGated ? '#contact' : `mailto:${person.email}?subject=${encodeURIComponent(`${t.title}: preview request`)}`}
					title={t.title}
					body={t.body}
					label="Sanitized preview on request"
					mark={t.mark}
				/>
			))
		}
		<IndexRow
			href={contactGated ? '#contact' : `mailto:${person.email}?subject=BRD%20request`}
			title="Business requirements document: structured AI intake"
			body="The BRD I wrote at Keshet for a structured intake system with duplication checks and risk scoring. Internal, so it isn't published here."
			label="Available on request"
			mark="half"
		/>
	</ol>
</BaseLayout>

<style>
	.dek {
		max-width: 42rem;
		color: var(--color-text-muted);
		margin-top: var(--space-2);
	}

	.rows {
		margin-top: var(--space-title);
	}
</style>
