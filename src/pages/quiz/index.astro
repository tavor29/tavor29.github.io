---
// The "Your call" quiz as its own page (Tavor's call, 2026-11-20): rounds of
// PMP-style situations from tech and startups, each with a cartoon. The
// homepage links here from components/home/YourCall.astro.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Label from '../../components/ui/Label.astro';
import Icon from '../../components/Icon.astro';
import Quiz from '../../components/quiz/Quiz.astro';
import { rounds } from '../../data/quiz';

const total = rounds.flat().length;
---

<BaseLayout
	bare
	title="Your call: a PM quiz"
	description={`${total} everyday project management calls, from easy to hard. Pick what you’d do, then see the best answer and why.`}
>
	<div data-ui class="pt-section pb-section">
		<Container class="flex flex-col gap-title">
			<header data-reveal class="flex items-end justify-between gap-gutter">
				<div class="flex flex-col gap-tight">
					<Label class="text-ink-muted">Quick game</Label>
					<h1 class="font-display text-3xl leading-title tracking-display">Your call</h1>
					<p class="max-w-2xl text-lg text-ink-muted">
						Everyday project management calls, from easy to hard. Pick what you’d do, then see the best answer and why.
					</p>
				</div>
				<Icon name="circle" size="md" tone="mark" class="shrink-0" />
			</header>
			<Quiz />
		</Container>
	</div>
</BaseLayout>
