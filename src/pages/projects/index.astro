---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/cards/WorkCard.astro';
import { work } from '../../data/work';

const items = work.filter((w) => !w.real);
---

<BaseLayout title="Projects">
	<h1>Projects</h1>
	<p class="dek">Two coded projects, each with a live demo and its own repo.</p>

	<ul data-ui class="cards grid gap-x-gutter gap-y-stack md:grid-cols-2">
		{
			items.map((item) => (
				<li>
					<WorkCard item={item} />
				</li>
			))
		}
	</ul>
</BaseLayout>

<style>
	.dek {
		max-width: 42rem;
		color: var(--color-text-muted);
		margin-top: var(--space-2);
	}

	.cards {
		margin-top: var(--space-title);
	}
</style>
