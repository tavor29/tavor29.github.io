---
// The full résumé that used to sit under the old homepage, now its own page.
// Printing it prints the résumé with its own header, matching the PDF.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Resume from '../../components/Resume.astro';
import { withBase } from '../../lib/base';
---

<BaseLayout title="Résumé">
	<div class="print-header">
		<p class="print-name">Tavor Ben-Shahar</p>
		<p>Business Operations &amp; Program Manager</p>
		<p>
			Tel Aviv, Israel &middot; 050-492-2040 &middot; tzavor29@gmail.com &middot; linkedin.com/in/tavor-bs
			&middot; github.com/tavor29
		</p>
	</div>

	<header class="resume-head">
		<h1>Résumé</h1>
		<p><a href={withBase('Tavor_Ben_Shahar_Resume.pdf')}>Download the PDF</a></p>
	</header>

	<Resume />
</BaseLayout>

<style>
	.resume-head {
		margin-bottom: var(--space-5);
	}

	.resume-head h1 {
		margin: 0 0 var(--space-2);
	}

	.print-header {
		display: none;
	}

	@media print {
		.resume-head {
			display: none;
		}

		.print-header {
			display: block;
		}

		.print-header p {
			margin: 0 0 0.2rem;
		}

		.print-name {
			font-size: var(--text-2xl);
			font-weight: 700;
		}
	}
</style>
