---
import Icon from '../../components/Icon.astro';
import CoverArt from '../../components/CoverArt.astro';
import PostCard from '../../components/cards/PostCard.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/base';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter((h) => h.depth === 2);

// "More articles": the three newest other posts.
const more = (await getCollection('blog'))
	.filter((p) => p.id !== post.id)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const formattedDate = post.data.date.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<BaseLayout title={post.data.title}>
	<div class="post-layout">
		<aside class="post-meta">
			<p class="post-date">{formattedDate}</p>
			<p class="back-link back-link--top"><a class="icon-link" href={withBase('blog/')}><Icon name="arrow" size="sm" class="rotate-180" />All posts</a></p>
		</aside>

		<article class="post">
			<h1>{post.data.title}</h1>
			<div class="post-cover"><CoverArt seed={post.id} shape="wide" /></div>
			<div class="post-body">
				<Content />
			</div>
			<p class="back-link"><a class="icon-link" href={withBase('blog/')}><Icon name="arrow" size="sm" class="rotate-180" />Back to all posts</a></p>
		</article>

		{
			sections.length > 0 && (
				<nav class="post-toc" aria-label="On this page">
					<p class="toc-label">On this page</p>
					<ul>
						{sections.map((h) => (
							<li>
								<a href={`#${h.slug}`}>{h.text}</a>
							</li>
						))}
					</ul>
				</nav>
			)
		}
	</div>
	<section data-ui class="more-articles flex flex-col gap-title">
		<SectionHead title="More articles" mark="leaf" />
		<ul class="grid gap-gutter sm:grid-cols-2 lg:grid-cols-3">
			{
				more.map((p) => (
					<li>
						<PostCard href={withBase(`blog/${p.id}/`)} slug={p.id} title={p.data.title} date={p.data.date} summary={p.data.summary} tag={p.data.tag} />
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

<style>
	/* Generated cover under the title (lib/cover-art.ts), the reference's article image. */
	.post-cover {
		aspect-ratio: 74 / 43;
		border-radius: var(--radius-md);
		overflow: hidden;
		margin-top: var(--space-4);
	}

	.more-articles {
		margin-top: var(--space-section);
	}

	/* Reading layout: the article stays at a comfortable line length in the
	   middle; on wide screens the date/back link and an "On this page" list
	   take the side columns. Below 72rem it's a single column. */
	.post {
		max-width: 44rem;
		margin-inline: auto;
	}

	.post-date {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		margin: 0 0 var(--space-2);
	}

	.back-link--top,
	.post-toc {
		display: none;
	}

	@media (min-width: 72rem) {
		.post-layout {
			display: grid;
			grid-template-columns: minmax(9rem, 1fr) minmax(0, 44rem) minmax(12rem, 1fr);
			column-gap: var(--space-6);
			align-items: start;
		}

		.post-meta,
		.post-toc {
			position: sticky;
			top: var(--space-4);
			max-width: 16rem;
			font-size: var(--text-sm);
		}

		.post-meta {
			justify-self: end;
			text-align: right;
			padding-top: 0.6rem;
		}

		.back-link--top {
			display: block;
			margin: 0;
		}

		.post-toc {
			display: block;
			justify-self: start;
			padding-top: 0.6rem;
		}
	}

	.toc-label {
		font-size: var(--text-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-label);
		color: var(--color-text-muted);
		margin: 0 0 var(--space-2);
	}

	.post-toc ul {
		list-style: none;
		margin: 0;
		padding: 0 0 0 var(--space-3);
		border-left: 2px solid var(--color-border);
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.post-toc a {
		color: var(--color-text-muted);
		text-decoration: none;
		line-height: 1.4;
	}

	.post-toc a:hover {
		color: var(--color-link);
	}

	.post h1 {
		margin-top: 0;
	}

	.post-body {
		margin-top: var(--space-4);
		line-height: 1.7;
	}

	.post-body :global(h2) {
		font-size: var(--text-xl);
		margin-top: var(--space-5);
		scroll-margin-top: var(--space-4);
	}

	.post-body :global(h3) {
		font-size: var(--text-lg);
		margin-top: var(--space-4);
	}

	.post-body :global(p) {
		margin: var(--space-3) 0;
	}

	.post-body :global(ul),
	.post-body :global(ol) {
		margin: var(--space-3) 0;
		padding-left: 1.5rem;
	}

	.post-body :global(li) {
		margin: var(--space-1) 0;
	}

	/* Images in a post (e.g. carousel slides): centred and capped, so a
	   portrait slide doesn't fill a whole screen. */
	.post-body :global(img) {
		display: block;
		width: 100%;
		max-width: 26rem;
		height: auto;
		margin: var(--space-4) auto;
		border-radius: var(--radius-md);
		border: 1px solid var(--color-border);
	}

	.post-body :global(blockquote) {
		margin: var(--space-3) 0;
		padding-left: var(--space-3);
		border-left: 3px solid var(--color-border);
		color: var(--color-text-muted);
	}

	.post-body :global(pre) {
		padding: var(--space-3);
		border-radius: var(--radius);
		overflow-x: auto;
		font-size: var(--text-sm);
	}

	.post-body :global(code) {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
	}

	.post-body :global(a) {
		color: var(--color-link);
	}

	.back-link {
		margin-top: var(--space-5);
	}
</style>
