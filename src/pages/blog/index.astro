---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/cards/PostCard.astro';
import { withBase } from '../../lib/base';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Insights & playbooks">
	<h1>Insights &amp; playbooks</h1>
	<p class="dek">Writing on AI adoption, governance, and building with Claude Code.</p>

	<ul data-ui class="cards grid gap-gutter sm:grid-cols-2 lg:grid-cols-3">
		{
			posts.map((post) => (
				<li>
					<PostCard
						href={withBase(`blog/${post.id}/`)}
						slug={post.id}
						title={post.data.title}
						date={post.data.date}
						summary={post.data.summary} tag={post.data.tag}
					/>
				</li>
			))
		}
	</ul>
</BaseLayout>

<style>
	.dek {
		max-width: 42rem;
		color: var(--color-text-muted);
		margin-top: var(--space-2);
	}

	.cards {
		margin-top: var(--space-title);
	}
</style>
