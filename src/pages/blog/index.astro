---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndexRow from '../../components/ui/IndexRow.astro';
import { withBase } from '../../lib/base';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatDate = (d: Date) =>
	d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="Blog">
	<h1>Blog</h1>
	<p class="dek">Writing on AI adoption, governance, and building with Claude Code.</p>

	<ul data-ui class="rows">
		{
			posts.map((post) => (
				<IndexRow
					href={withBase(`blog/${post.id}/`)}
					title={post.data.title}
					body={post.data.summary}
					meta={formatDate(post.data.date)}
				/>
			))
		}
	</ul>
</BaseLayout>

<style>
	.dek {
		max-width: 42rem;
		color: var(--color-text-muted);
		margin-top: var(--space-2);
	}

	.rows {
		margin-top: var(--space-title);
	}
</style>
