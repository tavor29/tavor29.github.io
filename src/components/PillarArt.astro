---
// Background illustrations for the three operating-pillar cards, drawn in the
// site's own palette (ink ground, the four mark colours, paper lines) rather
// than stock "tech" imagery:
//   network   — three clusters of nodes (R&D, Finance, Security) linked up
//   shield    — a shield built from two quarter shapes over a dot matrix
//   telemetry — a live dashboard: bar chart, gauge and trend line on a grid
// Decorative only; the card's text carries the meaning.

interface Props {
	variant: 'network' | 'shield' | 'telemetry';
	class?: string;
}

const { variant, class: className = '' } = Astro.props;

const C = { ink: '#0a0a0a', paper: '#fafafa', half: '#2a78d6', quarter: '#eb6834', circle: '#fab219', leaf: '#0ca30c' };
const W = 400;
const H = 500;

// Network: nodes per cluster, then links within and across clusters.
const clusters = [
	{ color: C.half, nodes: [[70, 90], [120, 60], [150, 120], [90, 150], [40, 130]] },
	{ color: C.circle, nodes: [[290, 70], [340, 110], [300, 150], [360, 50], [250, 110]] },
	{ color: C.leaf, nodes: [[180, 260], [230, 230], [250, 290], [200, 320], [150, 300]] },
];
const crossLinks = [
	[0, 2, 1, 4],
	[0, 1, 2, 0],
	[1, 2, 2, 1],
	[0, 3, 2, 4],
	[1, 1, 2, 2],
];

// Shield matrix and telemetry data (fixed, so the art is identical every build).
const dots = Array.from({ length: 11 * 14 }, (_, i) => [20 + (i % 11) * 36, 20 + Math.floor(i / 11) * 36]);
const bars = [0.35, 0.5, 0.42, 0.62, 0.55, 0.74, 0.68, 0.86];
const barColors = [C.half, C.half, C.quarter, C.half, C.circle, C.leaf, C.leaf, C.leaf];
const trend = [0.3, 0.38, 0.35, 0.5, 0.47, 0.6, 0.66, 0.78];
---

<svg
	class:list={['pillar-art', className]}
	viewBox={`0 0 ${W} ${H}`}
	preserveAspectRatio="xMidYMid slice"
	aria-hidden="true"
	focusable="false"
>
	<rect width={W} height={H} fill={C.ink} />
	{
		variant === 'network' && (
			<g>
				{clusters.map((c) =>
					c.nodes.map((a, i) =>
						c.nodes.slice(i + 1).map((b) => (
							<line x1={a[0]} y1={a[1]} x2={b[0]} y2={b[1]} stroke={c.color} stroke-opacity="0.45" stroke-width="1.5" />
						)),
					),
				)}
				{crossLinks.map(([ca, na, cb, nb]) => {
					const a = clusters[ca].nodes[na];
					const b = clusters[cb].nodes[nb];
					return <line x1={a[0]} y1={a[1]} x2={b[0]} y2={b[1]} stroke={C.paper} stroke-opacity="0.35" stroke-width="1.5" stroke-dasharray="4 6" />;
				})}
				{clusters.map((c) =>
					c.nodes.map(([x, y], i) => <circle cx={x} cy={y} r={i === 0 ? 14 : 8} fill={c.color} />),
				)}
			</g>
		)
	}
	{
		variant === 'shield' && (
			<g>
				{dots.map(([x, y]) => (
					<circle cx={x} cy={y} r="2" fill={C.paper} fill-opacity="0.18" />
				))}
				{/* Two mirrored quarter shapes meet in a point: a shield. */}
				<g transform="translate(200 250)">
					<path d="M0 -130 L0 110 A130 130 0 0 1 -130 -20 L-130 -130 Z" fill={C.leaf} />
					<path d="M0 -130 L0 110 A130 130 0 0 0 130 -20 L130 -130 Z" fill={C.leaf} fill-opacity="0.8" />
					<path d="M0 -92 L0 62 A84 84 0 0 1 -84 -22 L-84 -92 Z" fill={C.ink} />
					<path d="M0 -92 L0 62 A84 84 0 0 0 84 -22 L84 -92 Z" fill={C.ink} />
					<circle cx="0" cy="-20" r="22" fill={C.circle} />
				</g>
			</g>
		)
	}
	{
		variant === 'telemetry' && (
			<g>
				{Array.from({ length: 9 }, (_, i) => (
					<line x1="30" x2="370" y1={60 + i * 44} y2={60 + i * 44} stroke={C.paper} stroke-opacity="0.12" />
				))}
				{bars.map((v, i) => (
					<rect x={40 + i * 42} y={400 - v * 300} width="26" height={v * 300} rx="6" fill={barColors[i]} />
				))}
				<polyline
					points={trend.map((v, i) => `${53 + i * 42},${400 - v * 300 - 40}`).join(' ')}
					fill="none"
					stroke={C.paper}
					stroke-width="3"
					stroke-linejoin="round"
				/>
				{trend.map((v, i) => (
					<circle cx={53 + i * 42} cy={400 - v * 300 - 40} r="4" fill={C.paper} />
				))}
				{/* Gauge: a half ring with its reading. */}
				<g transform="translate(310 85)">
					<path d="M-44 0 A44 44 0 0 1 44 0" fill="none" stroke={C.paper} stroke-opacity="0.2" stroke-width="10" />
					<path d="M-44 0 A44 44 0 0 1 31 -31" fill="none" stroke={C.circle} stroke-width="10" />
				</g>
			</g>
		)
	}
</svg>

<style>
	.pillar-art {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
