---
import Container from './ui/Container.astro';
import Label from './ui/Label.astro';
import Rule from './ui/Rule.astro';
import ArrowChip from './ui/ArrowChip.astro';
import Icon from './Icon.astro';
import { withBase } from '../lib/base';
import { contact, person } from '../data/home';
import type { IconName } from '../lib/icons';

const marks: IconName[] = ['half', 'quarter', 'leaf', 'circle'];

const resolve = (href: string) => (/^(https?:|mailto:)/.test(href) ? href : withBase(href));
---

<footer id="contact" data-ui class="mt-section bg-ink pt-section pb-stack text-paper">
	<Container class="flex flex-col gap-title">
		<div class="flex flex-col gap-stack md:flex-row md:items-end md:justify-between">
			<div class="flex flex-col gap-gutter">
				<Label class="text-paper-muted">(05) Contact</Label>
				<h2 data-reveal class="font-serif text-2xl leading-display md:text-3xl">Let’s talk.</h2>
				<p data-reveal class="max-w-xl text-lg text-paper-muted">{person.availability}</p>
				<Label class="text-paper-muted">
					{person.location} · <a class="text-paper hover:underline" href={person.phoneHref}>{person.phone}</a>
				</Label>
			</div>
			{/* The four marks as a block: a row on phones, a 2×2 grid from md up. Each turns on hover. */}
			<div aria-hidden="true" class="grid w-max grid-cols-4 gap-tight md:grid-cols-2">
				{
					marks.map((m) => (
						<div data-shape-in class="pointer-events-auto">
							<Icon name={m} size="xl" tone="mark" class="transition-transform duration-base ease-out hover:rotate-90 md:hidden" />
							<Icon name={m} size="2xl" tone="mark" class="hidden transition-transform duration-base ease-out hover:rotate-90 md:block" />
						</div>
					))
				}
			</div>
		</div>
		<ul>
			{
				contact.map((c) => (
					<li data-reveal class="relative">
						<Rule tone="paper" />
						<a
							href={resolve(c.href)}
							{...(c.external ? { target: '_blank', rel: 'noreferrer' } : {})}
							class="group flex items-center justify-between py-gutter"
						>
							<span class="flex items-center gap-gutter font-display text-xl tracking-display transition-transform duration-base ease-out group-hover:translate-x-tight">
								<Icon name={c.mark} size="md" tone="mark" class="transition-transform duration-fast ease-out group-hover:rotate-90" />
								{c.label}
							</span>
							<ArrowChip inverted />
						</a>
					</li>
				))
			}
		</ul>
		<div class="flex items-end justify-between gap-gutter text-paper-muted">
			<Label>{`©${new Date().getFullYear()} ${person.name}`}</Label>
			<Label>/Astro · Tailwind · GSAP</Label>
		</div>
	</Container>
</footer>
