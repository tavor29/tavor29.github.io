---
// Asks once whether a visit may be recorded (PostHog session replay). Hidden
// until the script decides to show it: only when the visitor hasn't answered
// yet and doesn't send Do Not Track or Global Privacy Control. Analytics
// without recording runs either way, cookieless (scripts/analytics.ts). The
// privacy page's "Change my choice" button reopens it via a `consent:open`
// event.
import { withBase } from '../lib/base';
---

<div
	data-consent
	hidden
	role="region"
	aria-label="Recording consent"
	class="fixed inset-x-0 bottom-gutter z-50 flex justify-center px-gutter"
>
	<div class="flex max-w-xl flex-col gap-gutter rounded-md bg-ink p-gutter text-paper sm:flex-row sm:items-center">
		<p class="text-sm text-paper-muted">
			Mind if I record your visit to see how the site gets used? Anything you type stays hidden.{' '}
			<a href={withBase('privacy/')} class="text-paper underline underline-offset-4 hover:no-underline">Privacy</a>
		</p>
		<div class="flex shrink-0 items-center gap-gutter">
			<button
				type="button"
				data-consent-choice="yes"
				class="cursor-pointer rounded-sm border-0 bg-paper px-tight py-1 font-label text-xs uppercase tracking-label text-ink"
			>
				Allow
			</button>
			<button type="button" data-consent-choice="no" class="cursor-pointer border-0 bg-transparent p-0 text-sm text-paper underline underline-offset-4 hover:no-underline">
				No thanks
			</button>
		</div>
	</div>
</div>

<script>
	import { getConsent, setConsent, optedOut, track } from '../scripts/analytics';

	const banner = document.querySelector<HTMLElement>('[data-consent]');
	if (banner) {
		const show = () => {
			banner.hidden = false;
		};
		if (!optedOut() && getConsent() === null) setTimeout(show, 1500);

		banner.querySelectorAll<HTMLButtonElement>('[data-consent-choice]').forEach((button) =>
			button.addEventListener('click', () => {
				const choice = button.dataset.consentChoice === 'yes' ? 'yes' : 'no';
				setConsent(choice);
				track('recording_consent', { choice });
				banner.hidden = true;
			}),
		);

		document.addEventListener('consent:open', () => {
			if (!optedOut()) show();
		});
	}
</script>
