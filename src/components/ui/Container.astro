---
// Page gutter plus the 1180px content column.
interface Props {
	class?: string;
	outerClass?: string;
}
const { class: className = '', outerClass = '' } = Astro.props;
---

<div class:list={['px-gutter md:px-stack', outerClass]}>
	<div class:list={['mx-auto w-full max-w-container', className]}><slot /></div>
</div>
