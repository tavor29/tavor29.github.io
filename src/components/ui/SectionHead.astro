---
// Section heading: an optional small eyebrow label ("Discipline"), the title,
// an optional one-line intro under it, and the section's mark and number.
import Label from './Label.astro';
import Icon from '../Icon.astro';
import type { IconName } from '../../lib/icons';

interface Props {
	/** Section number, shown as (01). Omit for unnumbered sections. */
	index?: string;
	title: string;
	/** Small uppercase label above the title. */
	eyebrow?: string;
	/** One line under the title. */
	intro?: string;
	/** Colour mark shown beside the section number. */
	mark?: IconName;
}
const { index, title, eyebrow, intro, mark } = Astro.props;
---

<div data-reveal class="flex items-end justify-between gap-gutter">
	<div class="flex flex-col gap-tight">
		{eyebrow && <Label class="text-ink-muted">{eyebrow}</Label>}
		<h2 class="font-display text-2xl tracking-display leading-title">{title}</h2>
		{intro && <p class="max-w-2xl text-lg text-ink-muted">{intro}</p>}
	</div>
	<span class="flex shrink-0 items-center gap-tight pb-1">
		{mark && <Icon name={mark} size="md" tone="mark" class="self-center" />}
		{index && <Label class="text-ink-muted">({index})</Label>}
	</span>
</div>
