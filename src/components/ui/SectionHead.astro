---
import Label from './Label.astro';
import Icon from '../Icon.astro';
import type { IconName } from '../../lib/icons';

interface Props {
	index: string;
	title: string;
	/** Colour mark shown beside the section number. */
	mark?: IconName;
}
const { index, title, mark } = Astro.props;
---

<div data-reveal class="flex items-baseline justify-between gap-gutter">
	<h2 class="font-display text-2xl tracking-display leading-title">{title}</h2>
	<span class="flex items-center gap-tight">
		{mark && <Icon name={mark} size="md" tone="mark" class="self-center" />}
		<Label class="text-ink-muted">({index})</Label>
	</span>
</div>
