---
/*
 * One ruled row in an index list (projects, case studies, blog): the same
 * row the homepage's Selected work and Writing sections use, so every list
 * on the site reads the same. Wrap rows in <ol data-ui> / <ul data-ui>.
 * Leading slot: a shape mark (`mark`) or a small label such as a date (`meta`).
 */
import Icon from '../Icon.astro';
import Label from './Label.astro';
import Rule from './Rule.astro';
import ArrowChip from './ArrowChip.astro';
import StatusBadge from './StatusBadge.astro';
import type { Status } from '../../lib/projects';
import type { IconName } from '../../lib/icons';

interface Props {
	href: string;
	title: string;
	body?: string;
	/** Small uppercase line under the body, e.g. "Keshet Media Group · 2026". */
	label?: string;
	/** Leading date or short text, used instead of a mark. */
	meta?: string;
	mark?: IconName;
	/** Solid mark for case studies and real-work items, outline for coded projects and worked examples. */
	real?: boolean;
	/** Coded projects: a status badge under the label. */
	status?: Status;
	/** Heading level for the title: 2 on index pages, 3 inside a homepage section. */
	level?: 2 | 3;
}

const { href, title, body, label, meta, mark, real = true, status, level = 2 } = Astro.props;
const Heading = level === 3 ? 'h3' : 'h2';
---

<li data-reveal class="relative">
	<Rule />
	<a
		href={href}
		class="group grid grid-cols-[auto_1fr_auto] items-start gap-x-gutter gap-y-tight py-stack md:grid-cols-12"
	>
		{/* A date sits above the title on phones; a mark sits beside it. */}
		<span class:list={['md:col-span-2', !mark && 'col-span-2']}>
			{
				mark ? (
					<Icon
						name={mark}
						size="lg"
						variant={real ? 'solid' : 'outline'}
						tone="mark"
						class="transition-transform duration-fast ease-out group-hover:rotate-90"
					/>
				) : (
					<Label class="pt-1 text-ink-muted">{meta}</Label>
				)
			}
		</span>
		<div
			class:list={[
				'flex flex-col gap-tight md:col-span-8 md:col-start-3 md:row-start-1',
				mark ? 'col-start-2' : 'col-span-2 col-start-1 row-start-2',
			]}
		>
			<Heading class="font-display text-xl leading-title tracking-display transition-transform duration-base ease-out group-hover:translate-x-tight">
				{title}
			</Heading>
			{body && <p class="max-w-2xl text-base text-ink-muted">{body}</p>}
			{label && <Label>{label}</Label>}
			{status && <StatusBadge status={status} class="self-start" />}
		</div>
		<div class="col-start-3 row-start-1 justify-self-end md:col-span-1 md:col-start-12">
			<ArrowChip />
		</div>
	</a>
</li>
