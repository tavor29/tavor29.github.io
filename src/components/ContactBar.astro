---
// One-line row of contact buttons under the homepage nav. Each button reuses
// a shape and color from the Selected work index (WorkIndex.astro), and the
// shape turns on hover the same way, so the two read as one visual system.
// The label uses the hero's accent serif. On small screens the label, then
// the shapes, drop out so the buttons still fit on one line.
import { withBase } from '../lib/base';

const links = [
	{ label: 'Email', href: 'mailto:tzavor29@gmail.com', shape: 'half', colorVar: '--chart-series-1' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/tavor-bs/', shape: 'quarter', colorVar: '--chart-series-2' },
	{ label: 'GitHub', href: 'https://github.com/tavor29', shape: 'circle', colorVar: '--chart-status-warning' },
];
---

<nav class="contact-bar" aria-label="Contact and résumé">
	<span class="contact-bar__label">Let's talk</span>
	{
		links.map((l) => (
			<a class="contact-btn" href={l.href}>
				<span
					class={`btn-mark btn-mark--${l.shape}`}
					style={`--mark-color: var(${l.colorVar});`}
					aria-hidden="true"
				/>
				{l.label}
			</a>
		))
	}
	<a class="contact-btn contact-btn--primary" href={withBase('Tavor_Ben_Shahar_Resume.pdf')}>
		<span class="btn-mark btn-mark--leaf" style="--mark-color: var(--color-accent-contrast);" aria-hidden="true"
		></span>
		Résumé<span class="pdf-hint">&nbsp;(PDF)</span>
	</a>
</nav>

<style>
	/* overflow-x is only a safety net for very narrow screens: the row scrolls
	   inside itself instead of widening the page. */
	.contact-bar {
		display: flex;
		align-items: center;
		flex-wrap: nowrap;
		gap: var(--space-2);
		overflow-x: auto;
		scrollbar-width: none;
		padding: 2px;
		margin: -2px;
	}

	.contact-bar__label {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: var(--text-lg);
		color: var(--color-accent);
		margin-right: var(--space-1);
		white-space: nowrap;
	}

	.contact-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.35rem 0.9rem;
		border: 1.5px solid var(--color-border);
		border-radius: 999px;
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--color-text);
		text-decoration: none;
		white-space: nowrap;
		transition: border-color 0.2s ease;
	}

	.contact-btn:hover,
	.contact-btn:focus-visible {
		border-color: var(--color-accent);
	}

	.contact-btn:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	.contact-btn--primary {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--color-accent-contrast);
	}

	/* Same four shapes as the work index marks, at button scale. */
	.btn-mark {
		width: 0.8rem;
		height: 0.8rem;
		flex-shrink: 0;
		background: var(--mark-color);
		transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.btn-mark--half {
		border-radius: 0 100% 100% 0 / 0 50% 50% 0;
	}

	.btn-mark--quarter {
		border-radius: 0 100% 0 0;
	}

	.btn-mark--circle {
		border-radius: 50%;
	}

	.btn-mark--leaf {
		border-radius: 0 50% 0 50%;
	}

	.contact-btn:hover .btn-mark,
	.contact-btn:focus-visible .btn-mark {
		transform: rotate(90deg) scale(1.1);
	}

	@media (prefers-reduced-motion: reduce) {
		.btn-mark {
			transition: none;
		}

		.contact-btn:hover .btn-mark,
		.contact-btn:focus-visible .btn-mark {
			transform: none;
		}
	}

	/* Keep it to one line on phones: drop the label, then the shapes. */
	@media (max-width: 36rem) {
		.contact-bar__label {
			display: none;
		}
	}

	@media (max-width: 26rem) {
		.contact-bar {
			gap: 0.3rem;
		}

		.contact-btn {
			padding: 0.3rem 0.6rem;
			font-size: var(--text-xs);
		}

		.btn-mark,
		.pdf-hint {
			display: none;
		}
	}

	@media (max-width: 21rem) {
		.contact-btn {
			padding: 0.3rem 0.45rem;
		}
	}
</style>
