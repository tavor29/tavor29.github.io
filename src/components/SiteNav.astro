---
// Fixed pill nav, same on every page. Section links point at the homepage so
// they work from inner pages too; Contact is the footer, which every page has.
import { withBase } from '../lib/base';
import { person } from '../data/home';

const links = [
	{ label: 'About', href: withBase('about/') },
	{ label: 'Projects', href: withBase('#built') },
	{ label: 'Work', href: withBase('#work') },
	{ label: 'Writing', href: withBase('#writing') },
	{ label: 'Templates', href: withBase('templates/') },
	{ label: 'Contact', href: '#contact' },
];
---

<header data-ui class="fixed inset-x-0 top-gutter z-50 flex justify-center px-gutter">
	<nav aria-label="Main" class="flex items-center gap-stack rounded-md bg-ink p-gutter text-paper">
		<a href={withBase('')} class="text-lg font-semibold tracking-display">{person.name}</a>
		<ul class="hidden items-center gap-gutter text-sm text-paper-muted md:flex">
			{
				links.map((l) => (
					<li>
						<a href={l.href} class="transition-colors duration-fast ease-out hover:text-paper">
							{l.label}
						</a>
					</li>
				))
			}
		</ul>
		<a
			href={withBase(person.resume)}
			data-track="resume"
			class="rounded-sm bg-paper px-tight py-1 font-label text-xs uppercase tracking-label text-ink"
		>
			Résumé
		</a>
	</nav>
</header>
