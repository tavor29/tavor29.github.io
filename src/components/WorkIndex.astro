---
// Homepage "Selected work" index: one line per engagement (name, real vs.
// fictional label, years) with the outcome line from the content package's
// homepage blurbs. Each row carries a small geometric mark, solid for real
// work and outlined for fictional demos, that turns on hover, so the index
// itself is the visual. Real work leads, it's the stronger credibility signal.
import { withBase } from '../lib/base';

const items = [
	{
		title: 'Keshet Media Group',
		kind: 'Real work',
		years: '2026',
		line: 'Helped design AI governance and intake for around 40 unsanctioned tool builders, and reviewed licensing across roughly 750 seats.',
		href: withBase('case-studies/keshet/'),
		shape: 'half',
		colorVar: '--chart-series-1',
		real: true,
	},
	{
		title: 'Applied Materials',
		kind: 'Real work',
		years: '2023 – 2026',
		line: 'Built the dashboards a 1,200-plus-employee capital program’s leadership used to see schedule and budget risk without asking around.',
		href: withBase('case-studies/applied-materials/'),
		shape: 'quarter',
		colorVar: '--chart-series-2',
		real: true,
	},
	{
		title: 'AI Project Intake & Governance Agent',
		kind: 'Fictional demo',
		years: '2026',
		line: 'An agent that turns a chat-based tool request into a structured intake with a duplication check and a risk score.',
		href: withBase('projects/ai-intake-governance-agent/'),
		shape: 'circle',
		colorVar: '--chart-status-warning',
		real: false,
	},
	{
		title: 'Citizen Development Governance Model',
		kind: 'Fictional demo',
		years: '2026',
		line: 'A tracked path from idea to production for internally built tools, with a maintenance owner at every stage.',
		href: withBase('projects/citizen-development-governance/'),
		shape: 'leaf',
		colorVar: '--chart-status-good',
		real: false,
	},
];
---

<section class="work" aria-labelledby="work-heading">
	<h2 id="work-heading">Selected work</h2>
	<ul class="work-list">
		{
			items.map((item) => (
				<li>
					<a class="work-row" href={item.href}>
						<span
							class={`mark mark--${item.shape} ${item.real ? 'mark--solid' : 'mark--outline'}`}
							style={`--mark-color: var(${item.colorVar});`}
							aria-hidden="true"
						/>
						<span class="work-body">
							<span class="work-head">
								<span class="work-title">{item.title}</span>
								<span class="work-meta">
									{item.kind} &middot; {item.years}
								</span>
							</span>
							<span class="work-line">{item.line}</span>
						</span>
						<span class="work-arrow" aria-hidden="true">
							&rarr;
						</span>
					</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	/* Same heading treatment as the resume sections below it. */
	.work h2 {
		font-size: var(--text-lg);
		padding-bottom: var(--space-2);
		border-bottom: 2px solid var(--color-border);
		margin: 0;
	}

	.work-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.work-row {
		display: grid;
		grid-template-columns: 2.75rem 1fr auto;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-3) var(--space-1);
		border-bottom: 1px solid var(--color-border);
		color: inherit;
		text-decoration: none;
	}

	.work-row:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
		border-radius: var(--radius);
	}

	.work-body {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
	}

	.work-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		column-gap: var(--space-2);
	}

	.work-title {
		font-weight: 700;
		transition: color 0.2s ease;
	}

	.work-meta {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	.work-line {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.work-arrow {
		color: var(--color-text-muted);
		transition:
			transform 0.3s ease,
			color 0.2s ease;
	}

	/* Marks: one square, four border-radius shapes. */
	.mark {
		width: 2.75rem;
		height: 2.75rem;
		transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.mark--solid {
		background: var(--mark-color);
	}

	.mark--outline {
		border: 3px solid var(--mark-color);
	}

	.mark--half {
		border-radius: 0 100% 100% 0 / 0 50% 50% 0;
	}

	.mark--quarter {
		border-radius: 0 100% 0 0;
	}

	.mark--circle {
		border-radius: 50%;
	}

	.mark--leaf {
		border-radius: 0 50% 0 50%;
	}

	.work-row:hover .work-title,
	.work-row:focus-visible .work-title {
		color: var(--color-accent);
	}

	.work-row:hover .work-arrow,
	.work-row:focus-visible .work-arrow {
		color: var(--color-accent);
		transform: translateX(4px);
	}

	.work-row:hover .mark,
	.work-row:focus-visible .mark {
		transform: rotate(90deg) scale(1.06);
	}

	@media (prefers-reduced-motion: reduce) {
		.mark,
		.work-arrow {
			transition: none;
		}

		.work-row:hover .mark,
		.work-row:focus-visible .mark {
			transform: none;
		}
	}

	@media (max-width: 30rem) {
		.work-row {
			grid-template-columns: 2.25rem 1fr;
		}

		.mark {
			width: 2.25rem;
			height: 2.25rem;
		}

		.work-arrow {
			display: none;
		}
	}
</style>
