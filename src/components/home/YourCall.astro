---
// "Your call": the PMP-style quiz as a homepage section (components/Quiz.astro).
import Container from '../ui/Container.astro';
import SectionHead from '../ui/SectionHead.astro';
import Quiz from '../Quiz.astro';
---

<section id="your-call" class="pt-section">
	<Container class="flex flex-col gap-title">
		<SectionHead
			index="04"
			eyebrow="Quick game"
			title="Your call"
			intro="Situations project managers face in tech and startups, easy to hard. Pick what you’d do first."
			mark="circle"
		/>
		<div data-reveal>
			<Quiz />
		</div>
	</Container>
</section>
