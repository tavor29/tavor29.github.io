---
// Writing: the two newest posts as cover cards, then a dark "All posts" card
// (the reference's Thoughts section). Posts come from the blog collection.
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import SectionHead from '../ui/SectionHead.astro';
import PostCard from '../cards/PostCard.astro';
import LinkCard from '../cards/LinkCard.astro';
import { withBase } from '../../lib/base';

const all = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = all.slice(0, 2);
---

<section id="writing" class="pt-section">
	<Container class="flex flex-col gap-title">
		<SectionHead index="05" eyebrow="Writing" title="Notes from the field" mark="leaf" />
		<ul class="grid gap-gutter sm:grid-cols-2 lg:grid-cols-3">
			{
				latest.map((p) => (
					<li>
						<PostCard href={withBase(`blog/${p.id}/`)} slug={p.id} title={p.data.title} date={p.data.date} summary={p.data.summary} tag={p.data.tag} />
					</li>
				))
			}
			<li>
				<LinkCard href={withBase('blog/')} title="All posts" meta={`${all.length} articles`} />
			</li>
		</ul>
	</Container>
</section>
