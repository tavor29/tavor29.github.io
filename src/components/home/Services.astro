---
// What I actually do: five short bullets as ruled rows, each with a shape
// mark, a title and one line. Copy lives in data/home.ts.
import Container from '../ui/Container.astro';
import SectionHead from '../ui/SectionHead.astro';
import Rule from '../ui/Rule.astro';
import Icon from '../Icon.astro';
import { services } from '../../data/home';
---

<section id="services" class="pt-section">
	<Container class="flex flex-col gap-title">
		<SectionHead
			index="02"
			eyebrow="Discipline"
			title="What I actually do"
			intro="Program management and business operations for technology teams."
			mark="circle"
		/>
		<ul>
			{
				services.map((s) => (
					<li data-reveal class="group relative grid gap-tight py-gutter md:grid-cols-12 md:items-baseline md:gap-gutter">
						<Rule />
						<h3 class="flex items-center gap-tight font-display text-xl leading-title tracking-display md:col-span-5">
							<Icon name={s.mark} size="md" tone="mark" class="shrink-0 transition-transform duration-fast ease-out group-hover:rotate-90" />
							{s.title}
						</h3>
						<p class="text-base text-ink-muted md:col-span-7">{s.text}</p>
					</li>
				))
			}
		</ul>
	</Container>
</section>
