---
import Container from '../ui/Container.astro';
import Label from '../ui/Label.astro';
import Icon from '../Icon.astro';
import { person } from '../../data/home';
import type { IconName } from '../../lib/icons';

// The four marks float around the headline on wide screens (the reference's
// sticker slots). Positions are percentages of the hero; `speed` scales how
// far each one drifts and turns on scroll (scripts/motion.ts).
const floaters: {
	name: IconName;
	size: 'lg' | 'xl' | '2xl';
	variant: 'solid' | 'outline';
	pos: string;
	speed: number;
}[] = [
	{ name: 'circle', size: 'xl', variant: 'outline', pos: 'left: 11%; top: 22%', speed: 0.6 },
	{ name: 'leaf', size: '2xl', variant: 'solid', pos: 'right: 7%; top: 26%', speed: 1 },
	{ name: 'quarter', size: 'xl', variant: 'solid', pos: 'left: 7%; top: 60%', speed: 0.8 },
	{ name: 'half', size: 'lg', variant: 'solid', pos: 'right: 15%; top: 64%', speed: 1.3 },
];
const marks: IconName[] = ['half', 'quarter', 'circle', 'leaf'];
---

<section id="top" class="relative flex min-h-svh flex-col pt-section pb-stack">
	<div aria-hidden="true" class="pointer-events-none absolute inset-0 hidden xl:block">
		{
			floaters.map((f) => (
				<div data-shape-float data-speed={f.speed} class="absolute" style={f.pos}>
					<div data-shape-pop>
						<Icon name={f.name} size={f.size} variant={f.variant} tone="mark" />
					</div>
				</div>
			))
		}
	</div>

	<Container outerClass="flex flex-1 flex-col" class="flex flex-1 flex-col gap-title">
		<div class="flex flex-1 flex-col items-center justify-center gap-stack text-center">
			{/* Narrower screens get the four marks as a row instead of floating around the headline. */}
			<div aria-hidden="true" class="flex items-center gap-tight xl:hidden">
				{
					marks.map((m) => (
						<div data-shape-pop>
							<Icon name={m} size="md" tone="mark" />
						</div>
					))
				}
			</div>
			<Label class="flex items-center gap-tight text-ink-muted">
				<span aria-hidden="true" class="size-dot rounded-full bg-accent"></span>
				{person.role}
			</Label>
			<h1 class="font-display text-2xl leading-display tracking-display md:text-3xl">
				<span class="block overflow-hidden pb-1">
					<span data-hero-line class="block text-balance">{person.heroLead}</span>
				</span>
				<span class="block overflow-hidden pb-1">
					<span data-hero-line class="block text-balance font-serif">
						{person.heroEmphasis}<span class="text-accent">.</span>
					</span>
				</span>
			</h1>
			<p data-hero-fade class="max-w-xl text-lg text-balance text-ink-muted">{person.heroSub}</p>
		</div>

		<div data-hero-fade class="flex items-end justify-between gap-gutter">
			<p class="font-display text-2xl leading-display tracking-display">©2026</p>
			<Label class="text-right">/Five years · IT, R&amp;D, Ops</Label>
		</div>
	</Container>
</section>
