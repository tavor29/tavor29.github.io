---
import Container from '../ui/Container.astro';
import Label from '../ui/Label.astro';
import Icon from '../Icon.astro';
import { person } from '../../data/home';
import type { IconName } from '../../lib/icons';

// The four marks float around the headline (the reference's sticker slots).
// x/y are each shape's centre as a percentage of the hero: `wide` from 1280px
// up (beside the headline), `narrow` below (in the open bands above and below
// the text). They start there, stay there for reduced motion on wide screens,
// and are the spots scripts/shape-field.ts gently pulls them back toward while
// they drift, bounce off text marked data-shape-obstacle and bump each other.
const floaters: {
	name: IconName;
	size: 'lg' | 'xl' | '2xl' | '3xl';
	variant: 'solid' | 'outline';
	wide: [number, number];
	narrow: [number, number];
}[] = [
	// Four sizes, one each, for contrast: one dominant shape, one supporting,
	// two accents. The sizes scale down with the screen (see <style> below).
	{ name: 'leaf', size: '3xl', variant: 'solid', wide: [89, 23], narrow: [80, 17] },
	{ name: 'quarter', size: '2xl', variant: 'solid', wide: [9, 63], narrow: [78, 80] },
	{ name: 'circle', size: 'xl', variant: 'outline', wide: [15, 24], narrow: [20, 15] },
	{ name: 'half', size: 'lg', variant: 'solid', wide: [81, 68], narrow: [24, 78] },
];
const marks: IconName[] = ['half', 'quarter', 'circle', 'leaf'];
---

<section id="top" class="relative flex min-h-svh flex-col pt-section pb-stack">
	{/* Moving shapes at every size; with reduced motion, only wide screens keep them (static). */}
	<div
		data-shape-field
		aria-hidden="true"
		class="pointer-events-none absolute inset-0 block overflow-hidden motion-reduce:hidden xl:motion-reduce:block"
	>
		{
			floaters.map((f) => (
				<div
					data-shape-body
					class="shape-body absolute -translate-x-1/2 -translate-y-1/2"
					style={`--x: ${f.wide[0]}%; --y: ${f.wide[1]}%; --xn: ${f.narrow[0]}%; --yn: ${f.narrow[1]}%`}
				>
					<div data-shape-pop>
						<Icon name={f.name} size={f.size} variant={f.variant} tone="mark" />
					</div>
				</div>
			))
		}
	</div>

	<Container outerClass="flex flex-1 flex-col" class="flex flex-1 flex-col gap-title">
		<div class="flex flex-1 flex-col items-center justify-center gap-stack text-center">
			{/* Reduced motion below 1280px: the four marks as a still row instead of the moving field. */}
			<div aria-hidden="true" class="hidden items-center gap-tight motion-reduce:flex xl:motion-reduce:hidden">
				{
					marks.map((m) => (
						<div data-shape-pop>
							<Icon name={m} size="md" tone="mark" />
						</div>
					))
				}
			</div>
			<Label data-shape-obstacle class="flex items-center gap-tight text-ink-muted">
				<span aria-hidden="true" class="size-dot rounded-full bg-accent"></span>
				{person.role}
			</Label>
			<h1 class="font-display text-2xl leading-display tracking-display md:text-3xl">
				<span class="block overflow-hidden pb-1">
					<span data-hero-line data-shape-obstacle class="block text-balance">{person.heroLead}</span>
				</span>
				<span class="block overflow-hidden pb-1">
					<span data-hero-line data-shape-obstacle class="block text-balance font-serif">
						{person.heroEmphasis}<span class="text-accent">.</span>
					</span>
				</span>
			</h1>
			<p data-hero-fade data-shape-obstacle class="max-w-xl text-lg text-balance text-ink-muted">{person.heroSub}</p>
		</div>

		<div data-hero-fade class="flex items-end justify-between gap-gutter">
			<p data-shape-obstacle class="font-display text-2xl leading-display tracking-display">©2026</p>
			<Label data-shape-obstacle class="text-right">/Five years · IT, R&amp;D, Ops</Label>
		</div>
	</Container>
</section>

<style>
	/* Hero shape sizes scale with the screen: full size at 1440px wide, floored
	   so the smallest still reads on a phone. */
	[data-shape-field] {
		--icon-3xl: clamp(96px, 13.9vw, 200px);
		--icon-2xl: clamp(64px, 8.33vw, 120px);
		--icon-xl: clamp(40px, 4.44vw, 64px);
		--icon-lg: clamp(32px, 3.06vw, 44px);
	}

	.shape-body {
		left: var(--xn);
		top: var(--yn);
	}

	@media (min-width: 1280px) {
		.shape-body {
			left: var(--x);
			top: var(--y);
		}
	}
</style>
