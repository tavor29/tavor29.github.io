---
// Selected work: each case study as a full-width hero card.
import Container from '../ui/Container.astro';
import SectionHead from '../ui/SectionHead.astro';
import CaseCard from '../cards/CaseCard.astro';
import { caseStudies } from '../../data/case-studies';
---

<section id="work" class="pt-section">
	<Container class="flex flex-col gap-title">
		<SectionHead index="05" eyebrow="Case studies" title="Selected work" mark="half" />
		<ul class="flex flex-col gap-gutter">
			{
				caseStudies.map((c) => (
					<li>
						<CaseCard c={c} />
					</li>
				))
			}
		</ul>
	</Container>
</section>
