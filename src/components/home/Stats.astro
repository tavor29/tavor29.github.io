---
// "Results from recent roles": six countable facts under About (two per row on
// phones, three on wide screens), each with the
// company it happened at. Numbers count up once as they scroll in (data-count,
// scripts/motion.ts); the final value is in the HTML, so no-JS and reduced
// motion just show it.
import Container from '../ui/Container.astro';
import Label from '../ui/Label.astro';
import Rule from '../ui/Rule.astro';
import Icon from '../Icon.astro';
import { stats } from '../../data/home';

const format = (n: number) => n.toLocaleString('en-US');
---

<section aria-labelledby="results-heading" class="pt-section">
	<Container class="flex flex-col gap-stack">
		<Label class="text-ink-muted"><span id="results-heading">Results from recent roles</span></Label>
		<ul class="grid grid-cols-2 gap-x-gutter lg:grid-cols-3">
			{
				stats.map((s) => (
					<li data-reveal class="group relative flex flex-col gap-tight py-gutter pr-tight md:py-stack md:pr-gutter">
						<Rule />
						<p class="font-display text-2xl leading-display tracking-display md:text-3xl">
							{s.prefix}<span data-count={s.value}>{format(s.value)}</span>{s.suffix}
						</p>
						<p class="text-sm md:text-base">{s.label}</p>
						<Label class="flex items-center gap-tight text-ink-muted">
							<Icon name={s.mark} size="sm" tone="mark" class="transition-transform duration-fast ease-out group-hover:rotate-90" />
							{s.where}
						</Label>
					</li>
				))
			}
		</ul>
	</Container>
</section>
