---
// Projects I've Built. Citizen AI Governance is one compact card: its thesis,
// then its three projects side by side, each with its stage and status. Other
// projects go below it as ruled rows. Copy: data/citizen-ai-governance.ts and
// content/projects/*.md.
import Container from '../ui/Container.astro';
import SectionHead from '../ui/SectionHead.astro';
import Label from '../ui/Label.astro';
import ArrowChip from '../ui/ArrowChip.astro';
import ArrowLink from '../ui/ArrowLink.astro';
import StatusBadge from '../ui/StatusBadge.astro';
import Icon from '../Icon.astro';
import { umbrella } from '../../data/citizen-ai-governance';
import { getProjects, projectHref, stageLabel } from '../../lib/projects';
import { withBase } from '../../lib/base';

const projects = await getProjects();
---

<section id="built" class="pt-section">
	<Container class="flex flex-col gap-title">
		<SectionHead index="03" eyebrow="Projects I’ve Built" title="Real organizational pain. Real solutions." mark="leaf" />
		<div data-reveal class="flex flex-col gap-gutter rounded-md bg-ink p-gutter text-paper md:p-stack md:pb-gutter">
			<a
				href={withBase('projects/citizen-ai-governance/')}
				class="group flex items-start justify-between gap-gutter"
			>
				<div class="flex flex-col gap-tight">
					<Label class="text-paper-muted">{projects.length} projects · Discover, decide, sustain</Label>
					<h3 class="font-display text-2xl leading-title tracking-display">{umbrella.title}</h3>
					<p class="max-w-2xl text-base text-paper-muted">{umbrella.thesis}</p>
				</div>
				<ArrowChip inverted />
			</a>
			<ol class="grid md:grid-cols-3">
				{
					projects.map((p, i) => (
						<li class:list={['border-t border-paper-rule', i > 0 && 'md:border-l md:pl-gutter', i < projects.length - 1 && 'md:pr-gutter']}>
							<a href={withBase(projectHref(p))} class="group flex h-full flex-col items-start gap-tight py-gutter">
								<span class="flex items-center gap-tight">
									<Icon
										name={p.data.mark}
										size="sm"
										variant="outline"
										tone="mark"
										class="transition-transform duration-fast ease-out group-hover:rotate-90"
									/>
									<Label class="text-paper-muted">{stageLabel(p.data.stage)}</Label>
								</span>
								<span class="font-display text-lg leading-title tracking-display group-hover:underline">
									{p.data.title}
								</span>
								<StatusBadge status={p.data.status} tone="paper" class="mt-auto" />
							</a>
						</li>
					))
				}
			</ol>
		</div>
		<div data-reveal class="flex flex-wrap gap-x-stack gap-y-gutter">
			<ArrowLink href={withBase('projects/')}>View all projects</ArrowLink>
			<ArrowLink href={withBase('templates/')}>Templates &amp; docs</ArrowLink>
		</div>
	</Container>
</section>
