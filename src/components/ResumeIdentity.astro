---
// Name, title, and contact card. On the homepage it sits in the sticky left
// column (see index.astro), so it stays in view while the reader scrolls the
// work index and resume on the right. Contact details match the resume PDF.
import { withBase } from '../lib/base';
---

<div class="identity">
	<div>
		<h1>Tavor Ben Shahar</h1>
		<p class="identity-title">Program Manager | AI Governance &amp; Organizational Transformation</p>
	</div>

	<ul class="contact-list">
		<li>
			<svg viewBox="0 0 24 24" aria-hidden="true"
				><path
					d="M12 22s7-7.58 7-12.5A7 7 0 0 0 5 9.5C5 14.42 12 22 12 22Z"
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"></path><circle
					cx="12"
					cy="9.5"
					r="2.4"
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"></circle></svg
			>
			<span>Tel Aviv, Israel</span>
		</li>
		<li>
			<svg viewBox="0 0 24 24" aria-hidden="true"
				><path
					d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1L6.6 10.8Z"
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"></path></svg
			>
			<span>050-492-2040</span>
		</li>
		<li>
			<svg viewBox="0 0 24 24" aria-hidden="true"
				><rect
					x="3"
					y="5"
					width="18"
					height="14"
					rx="2"
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"></rect><path
					d="m4 7 8 6 8-6"
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"></path></svg
			>
			<a href="mailto:tzavor29@gmail.com">tzavor29@gmail.com</a>
		</li>
		<li>
			<svg viewBox="0 0 24 24" aria-hidden="true"
				><rect
					x="3"
					y="3"
					width="18"
					height="18"
					rx="2.5"
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"></rect><path
					d="M8 10.5V16M8 7.6v.1M11.5 16v-5.5M11.5 13c0-1.6 1-2.6 2.4-2.6s2.1 1 2.1 2.6V16"
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linecap="round"></path></svg
			>
			<a href="https://www.linkedin.com/in/tavor-bs/">linkedin.com/in/tavor-bs</a>
		</li>
		<li>
			<svg viewBox="0 0 24 24" aria-hidden="true"
				><path
					d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.15-1.11-1.46-1.11-1.46-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.3 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
					fill="currentColor"></path></svg
			>
			<a href="https://github.com/tavor29">github.com/tavor29</a>
		</li>
	</ul>

	<a class="download-btn" href={withBase('Tavor_Ben_Shahar_Resume.pdf')}>
		Download résumé (PDF)
	</a>

</div>

<style>
	.identity {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding: var(--space-4);
		border-radius: calc(var(--radius) * 2);
		background: var(--color-bg-subtle);
		border-top: 4px solid var(--color-accent);
	}

	.identity h1 {
		font-size: var(--text-2xl);
		line-height: 1.1;
		margin: 0;
	}

	.identity-title {
		font-weight: 600;
		color: var(--color-accent);
		margin: var(--space-2) 0 0;
	}

	.contact-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		font-size: var(--text-sm);
	}

	.contact-list li {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.contact-list svg {
		width: 1.1rem;
		height: 1.1rem;
		flex-shrink: 0;
		color: var(--color-accent);
	}

	.contact-list a {
		color: var(--color-text);
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	.contact-list a:hover {
		color: var(--color-accent);
	}

	.download-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-weight: 600;
		font-size: var(--text-sm);
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius);
		background: var(--color-accent);
		color: var(--color-accent-contrast);
		text-decoration: none;
		text-align: center;
	}

	.download-btn:hover {
		opacity: 0.9;
	}

	@media print {
		.download-btn {
			display: none;
		}

		.identity {
			border: none;
			background: none;
			padding: 0;
		}
	}
</style>
