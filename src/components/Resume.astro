---

<section class="resume-page" id="resume">
	<div class="resume-body">
		<section class="resume-block">
			<h2>Summary</h2>
			<p class="resume-summary">
				Business operations and program manager with 5 years of experience running complex
				technology programs across enterprise organizations. Track record of working across
				Operations, Finance, IT, Security, and R&amp;D to turn operational friction into structured,
				repeatable programs. Experienced in building governance frameworks, leading AI tool
				rollouts, coordinating multi-million-dollar infrastructure programs, and delivering KPI
				dashboards that track real adoption. Seeking operations and program management roles at
				the intersection of software, AI, product, and cross-functional delivery.
			</p>
		</section>

		<section class="resume-block">
			<h2>Skills</h2>
			<div class="skills-grid">
				{
					skills.map((s) => (
						<div class="skill-group">
							<h3>{s.label}</h3>
							<p>{s.text}</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="resume-block">
			<h2>Experience</h2>
			<div class="timeline">
				{
					experience.map((job) => (
						<article class="job">
							<div class="job-marker" aria-hidden="true" />
							<div class="job-content">
								<div class="job-header">
									<h3>{job.role}</h3>
									<span class="job-dates">{job.dates}</span>
								</div>
								<p class="job-org">{job.org}</p>
								<ul>
									{job.bullets.map((b) => (
										<li>
											<strong>{b.label}:</strong> {b.text}
										</li>
									))}
								</ul>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="resume-block">
			<h2>Education</h2>
			<ul class="education-list">
				{
					education.map((e) => (
						<li>
							<span>
								<strong>{e.name}</strong> <em>&middot; {e.org}</em>
							</span>
							<span class="edu-dates">{e.dates}</span>
						</li>
					))
				}
			</ul>
		</section>

		<section class="resume-block">
			<h2>Languages</h2>
			<p class="languages">Native English &middot; Native Hebrew</p>
		</section>
	</div>
</section>

<style>
	.resume-summary {
		max-width: 75ch;
		color: var(--color-text-muted);
		margin: 0;
	}

	.resume-block + .resume-block {
		margin-top: var(--space-5);
	}

	.resume-block h2 {
		font-size: var(--text-lg);
		padding-bottom: var(--space-2);
		border-bottom: 2px solid var(--color-border);
		margin: 0 0 var(--space-4);
	}

	.skills-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: var(--space-4);
	}

	.skill-group h3 {
		font-size: var(--text-sm);
		font-weight: 600;
		margin: 0 0 var(--space-1);
	}

	.skill-group p {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		margin: 0;
	}

	.timeline {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding-left: var(--space-4);
		border-left: 2px solid var(--color-border);
	}

	.job {
		position: relative;
	}

	.job-marker {
		position: absolute;
		top: 0.4rem;
		left: calc(-1 * var(--space-4) - 5px);
		width: 9px;
		height: 9px;
		border-radius: 999px;
		background: var(--color-accent);
	}

	.job-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	.job-header h3 {
		font-size: var(--text-base);
		margin: 0;
	}

	.job-dates {
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--color-text-muted);
		background: var(--color-bg-subtle);
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		white-space: nowrap;
	}

	.job-org {
		font-size: var(--text-sm);
		color: var(--color-accent);
		font-weight: 600;
		margin: 0.1rem 0 0;
	}

	.job ul {
		margin: var(--space-2) 0 0;
		padding-left: 1.1rem;
		font-size: var(--text-sm);
	}

	/* Wide screens: role, dates, and company on the left, bullets beside them. */
	@media (min-width: 80rem) {
		.job-content {
			display: grid;
			grid-template-columns: 16rem minmax(0, 75ch);
			column-gap: var(--space-5);
			align-items: start;
		}

		.job-header,
		.job-org {
			grid-column: 1;
		}

		.job ul {
			grid-column: 2;
			grid-row: 1 / span 2;
			margin-top: 0;
		}
	}

	.job li {
		margin: var(--space-1) 0;
	}

	.education-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		font-size: var(--text-sm);
	}

	.education-list li {
		display: flex;
		justify-content: space-between;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	.education-list em {
		color: var(--color-text-muted);
		font-style: normal;
	}

	.edu-dates {
		color: var(--color-text-muted);
		white-space: nowrap;
		font-size: var(--text-xs);
	}

	.languages {
		font-size: var(--text-sm);
		margin: 0;
	}
</style>
