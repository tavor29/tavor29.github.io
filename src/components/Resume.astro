---
// Content transcribed from public/Tavor_Ben_Shahar_Resume.pdf, with two
// deliberate deviations: the Keshet adoption bullet uses the Keshet case
// study's wording so the two pages agree, and the summary's closing
// positioning sentence is site-only. Name, title, and contacts live in
// ResumeIdentity.astro (the homepage's sticky column), not here.

const skills = [
	{
		label: 'AI governance & adoption',
		text: 'AI tool governance program design from scratch, adoption tracking, security boundary definition, LLM integration and AI-assisted development.',
	},
	{
		label: 'Process & program design',
		text: 'Building process and governance frameworks where none existed, cross-functional leadership without direct authority, change adoption measured by effectiveness rather than launch.',
	},
	{
		label: 'Business-to-technical translation',
		text: 'Translating business needs into technical requirements, KPI dashboards and data-driven decision-making (SQL, Tableau, Power Query).',
	},
	{
		label: 'Project management',
		text: 'Agile, Scrum, Waterfall, hybrid delivery, vendor negotiation, risk management, Gantt planning, Jira, MS Project, Azure DevOps.',
	},
	{
		label: 'Stakeholder & executive communication',
		text: 'Bilingual (Hebrew & English) executive communication, working independently with senior leadership, cross-functional steering committees.',
	},
];

const experience = [
	{
		role: 'Business Operations Manager',
		org: 'Keshet Media Group',
		dates: '2026',
		bullets: [
			{
				label: 'Governance program design from scratch',
				text: 'built an AI tool governance program from nothing, with no existing playbook, defining approval workflows, security boundaries, and acceptance criteria directly with the CISO, Security, and business leadership.',
			},
			{
				label: 'Change adoption & governance planning',
				text: 'identified roughly 40 employees building their own AI tools without engineering support, surfaced the risk to leadership, and helped design a phased plan to bring that work under governance.',
			},
		],
	},
	{
		role: 'IT Project Manager & Infrastructure Lead',
		org: 'Applied Materials',
		dates: '2023 – 2026',
		bullets: [
			{
				label: 'Cross-functional program ownership',
				text: 'owned a multi-year program (1,200+ employee corporate office) end-to-end, covering scope, milestones, delivery, and status, while coordinating Finance, IT, R&D, and outside contractors without direct authority over them.',
			},
			{
				label: 'Data-driven decision-making',
				text: 'built automated KPI dashboards (SQL, Tableau) tracking schedule and budget performance, giving stakeholders and executives real-time, data-driven visibility to support informed decisions.',
			},
			{
				label: 'Business-to-technical translation & stakeholder alignment',
				text: 'translated business priorities and technical constraints into clear updates for Finance, Purchasing, and senior leadership, running recurring planning cycles to keep stakeholders aligned as priorities evolved.',
			},
		],
	},
	{
		role: 'Operations Manager',
		org: 'IBM',
		dates: '2021 – 2023',
		bullets: [
			{
				label: 'Structured delivery under ambiguity',
				text: 'directed IT transformation projects end-to-end with no fixed playbook, defining the process as requirements emerged and aligning matrixed teams against scope, budget, and schedule.',
			},
			{
				label: 'Risk management & crisis response',
				text: 'led migration and disaster-recovery initiatives, surfacing risks early and adapting plans in real time as requirements shifted to keep systems stable for end users.',
			},
		],
	},
];

const education = [
	{ name: 'AI Implementation in Organizations (160 hours)', org: 'HackerU', dates: '2026' },
	{ name: 'AI Performance Engineering (100 hours)', org: 'Nebius Academy', dates: '2026' },
	{
		name: 'BA, Business Administration, Information Systems',
		org: 'Ruppin Academic Center · Cum Laude',
		dates: '2020 – 2023',
	},
];
---

<section class="resume-page" id="resume">
	<div class="resume-body">
		<section class="resume-block">
			<h2>Summary</h2>
			<p class="resume-summary">
				Program manager with 5+ years leading organizational change and technology adoption
				across large enterprises, building governance frameworks, driving process improvement,
				and translating business needs into technical execution. Proven ability to build process
				from scratch where none existed: mapped how AI tools were spreading through an
				organization with no support, and built a governance program (approval workflows,
				security boundaries, adoption tracking) from the ground up. Leads cross-functional
				initiatives across IT, Security, and business stakeholders without direct authority, using
				KPI dashboards to measure whether change actually took hold, not just whether it launched.
				The common thread is business operations for organizations adopting AI: the governance,
				reporting, and licensing work that lets a company move fast on AI tools without losing
				track of what it runs or pays for.
			</p>
		</section>

		<section class="resume-block">
			<h2>Skills</h2>
			<div class="skills-grid">
				{
					skills.map((s) => (
						<div class="skill-group">
							<h3>{s.label}</h3>
							<p>{s.text}</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="resume-block">
			<h2>Experience</h2>
			<div class="timeline">
				{
					experience.map((job) => (
						<article class="job">
							<div class="job-marker" aria-hidden="true" />
							<div class="job-content">
								<div class="job-header">
									<h3>{job.role}</h3>
									<span class="job-dates">{job.dates}</span>
								</div>
								<p class="job-org">{job.org}</p>
								<ul>
									{job.bullets.map((b) => (
										<li>
											<strong>{b.label}:</strong> {b.text}
										</li>
									))}
								</ul>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="resume-block">
			<h2>Education</h2>
			<ul class="education-list">
				{
					education.map((e) => (
						<li>
							<span>
								<strong>{e.name}</strong> <em>&middot; {e.org}</em>
							</span>
							<span class="edu-dates">{e.dates}</span>
						</li>
					))
				}
			</ul>
		</section>

		<section class="resume-block">
			<h2>Languages</h2>
			<p class="languages">Native Hebrew &middot; Native English</p>
		</section>
	</div>
</section>

<style>
	.resume-summary {
		color: var(--color-text-muted);
		margin: 0;
	}

	.resume-block + .resume-block {
		margin-top: var(--space-5);
	}

	.resume-block h2 {
		font-size: var(--text-lg);
		padding-bottom: var(--space-2);
		border-bottom: 2px solid var(--color-border);
		margin: 0 0 var(--space-4);
	}

	.skills-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: var(--space-4);
	}

	.skill-group h3 {
		font-size: var(--text-sm);
		font-weight: 600;
		margin: 0 0 var(--space-1);
	}

	.skill-group p {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		margin: 0;
	}

	.timeline {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding-left: var(--space-4);
		border-left: 2px solid var(--color-border);
	}

	.job {
		position: relative;
	}

	.job-marker {
		position: absolute;
		top: 0.4rem;
		left: calc(-1 * var(--space-4) - 5px);
		width: 9px;
		height: 9px;
		border-radius: 999px;
		background: var(--color-accent);
	}

	.job-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	.job-header h3 {
		font-size: var(--text-base);
		margin: 0;
	}

	.job-dates {
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--color-text-muted);
		background: var(--color-bg-subtle);
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		white-space: nowrap;
	}

	.job-org {
		font-size: var(--text-sm);
		color: var(--color-accent);
		font-weight: 600;
		margin: 0.1rem 0 0;
	}

	.job ul {
		margin: var(--space-2) 0 0;
		padding-left: 1.1rem;
		font-size: var(--text-sm);
	}

	.job li {
		margin: var(--space-1) 0;
	}

	.education-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		font-size: var(--text-sm);
	}

	.education-list li {
		display: flex;
		justify-content: space-between;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	.education-list em {
		color: var(--color-text-muted);
		font-style: normal;
	}

	.edu-dates {
		color: var(--color-text-muted);
		white-space: nowrap;
		font-size: var(--text-xs);
	}

	.languages {
		font-size: var(--text-sm);
		margin: 0;
	}
</style>
