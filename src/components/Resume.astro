---
// Content transcribed from public/Tavor_Ben_Shahar_Resume.pdf, with one
// deliberate deviation: the Keshet adoption bullet uses the Keshet case
// study's wording so the two pages agree. This component is the whole homepage now (see index.astro), so it owns the
// name/title/contact header too, rather than repeating it from a separate
// homepage bio block.
import { withBase } from '../lib/base';

const skills = [
	{
		label: 'AI governance & adoption',
		text: 'AI tool governance program design from scratch, adoption tracking, security boundary definition, LLM integration and AI-assisted development.',
	},
	{
		label: 'Process & program design',
		text: 'Building process and governance frameworks where none existed, cross-functional leadership without direct authority, change adoption measured by effectiveness rather than launch.',
	},
	{
		label: 'Business-to-technical translation',
		text: 'Translating business needs into technical requirements, KPI dashboards and data-driven decision-making (SQL, Tableau, Power Query).',
	},
	{
		label: 'Project management',
		text: 'Agile, Scrum, Waterfall, hybrid delivery, vendor negotiation, risk management, Gantt planning, Jira, MS Project, Azure DevOps.',
	},
	{
		label: 'Stakeholder & executive communication',
		text: 'Bilingual (Hebrew & English) executive communication, working independently with senior leadership, cross-functional steering committees.',
	},
];

const experience = [
	{
		role: 'Business Operations Manager',
		org: 'Keshet Media Group',
		dates: '2026',
		bullets: [
			{
				label: 'Governance program design from scratch',
				text: 'built an AI tool governance program from nothing — no existing playbook — defining approval workflows, security boundaries, and acceptance criteria directly with the CISO, Security, and business leadership.',
			},
			{
				label: 'Change adoption & governance planning',
				text: 'identified roughly 40 employees building their own AI tools without engineering support, surfaced the risk to leadership, and helped design a phased plan to bring that work under governance.',
			},
		],
	},
	{
		role: 'IT Project Manager & Infrastructure Lead',
		org: 'Applied Materials',
		dates: '2023 – 2026',
		bullets: [
			{
				label: 'Cross-functional program ownership',
				text: 'owned a multi-year program (1,200+ employee corporate office) end-to-end — scope, milestones, delivery, and status — coordinating Finance, IT, R&D, and outside contractors without direct authority over them.',
			},
			{
				label: 'Data-driven decision-making',
				text: 'built automated KPI dashboards (SQL, Tableau) tracking schedule and budget performance, giving stakeholders and executives real-time, data-driven visibility to support informed decisions.',
			},
			{
				label: 'Business-to-technical translation & stakeholder alignment',
				text: 'translated business priorities and technical constraints into clear updates for Finance, Purchasing, and senior leadership, running recurring planning cycles to keep stakeholders aligned as priorities evolved.',
			},
		],
	},
	{
		role: 'Operations Manager',
		org: 'IBM',
		dates: '2021 – 2023',
		bullets: [
			{
				label: 'Structured delivery under ambiguity',
				text: 'directed IT transformation projects end-to-end with no fixed playbook, defining the process as requirements emerged and aligning matrixed teams against scope, budget, and schedule.',
			},
			{
				label: 'Risk management & crisis response',
				text: 'led migration and disaster-recovery initiatives, surfacing risks early and adapting plans in real time as requirements shifted to keep systems stable for end users.',
			},
		],
	},
];

const education = [
	{ name: 'AI Implementation in Organizations (160 hours)', org: 'HackerU', dates: '2026' },
	{ name: 'AI Performance Engineering (100 hours)', org: 'Nebius Academy', dates: '2026' },
	{
		name: 'BA, Business Administration, Information Systems',
		org: 'Ruppin Academic Center · Cum Laude',
		dates: '2020 – 2023',
	},
];
---

<section class="resume-page" id="resume">
	<header class="resume-hero">
		<div class="resume-hero__intro">
			<h1>Tavor Ben Shahar</h1>
			<p class="resume-title">Program Manager | AI Governance &amp; Organizational Transformation</p>
			<p class="resume-summary">
				Program manager with 5+ years leading organizational change and technology adoption
				across large enterprises — building governance frameworks, driving process improvement,
				and translating business needs into technical execution. Proven ability to build process
				from scratch where none existed: mapped how AI tools were spreading through an
				organization with no support, and built a governance program — approval workflows,
				security boundaries, adoption tracking — from the ground up. Leads cross-functional
				initiatives across IT, Security, and business stakeholders without direct authority, using
				KPI dashboards to measure whether change actually took hold, not just whether it launched.
			</p>
		</div>

		<div class="resume-hero__aside">
			<ul class="contact-list">
				<li>
					<svg viewBox="0 0 24 24" aria-hidden="true"
						><path
							d="M12 22s7-7.58 7-12.5A7 7 0 0 0 5 9.5C5 14.42 12 22 12 22Z"
							fill="none"
							stroke="currentColor"
							stroke-width="1.6"></path><circle
							cx="12"
							cy="9.5"
							r="2.4"
							fill="none"
							stroke="currentColor"
							stroke-width="1.6"></circle></svg
					>
					<span>Tel Aviv, Israel</span>
				</li>
				<li>
					<svg viewBox="0 0 24 24" aria-hidden="true"
						><path
							d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1L6.6 10.8Z"
							fill="none"
							stroke="currentColor"
							stroke-width="1.6"></path></svg
					>
					<span>050-492-2040</span>
				</li>
				<li>
					<svg viewBox="0 0 24 24" aria-hidden="true"
						><rect
							x="3"
							y="5"
							width="18"
							height="14"
							rx="2"
							fill="none"
							stroke="currentColor"
							stroke-width="1.6"></rect><path
							d="m4 7 8 6 8-6"
							fill="none"
							stroke="currentColor"
							stroke-width="1.6"></path></svg
					>
					<a href="mailto:tzavor29@gmail.com">tzavor29@gmail.com</a>
				</li>
				<li>
					<svg viewBox="0 0 24 24" aria-hidden="true"
						><path
							d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.15-1.11-1.46-1.11-1.46-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.3 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
							fill="currentColor"></path></svg
					>
					<a href="https://github.com/tavor29">github.com/tavor29</a>
				</li>
			</ul>

			<a class="download-btn" href={withBase('Tavor_Ben_Shahar_Resume.pdf')}>
				Download résumé (PDF)
			</a>
		</div>
	</header>

	<div class="resume-body">
		<section class="resume-block">
			<h2>Skills</h2>
			<div class="skills-grid">
				{
					skills.map((s) => (
						<div class="skill-group">
							<h3>{s.label}</h3>
							<p>{s.text}</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="resume-block">
			<h2>Experience</h2>
			<div class="timeline">
				{
					experience.map((job) => (
						<article class="job">
							<div class="job-marker" aria-hidden="true" />
							<div class="job-content">
								<div class="job-header">
									<h3>{job.role}</h3>
									<span class="job-dates">{job.dates}</span>
								</div>
								<p class="job-org">{job.org}</p>
								<ul>
									{job.bullets.map((b) => (
										<li>
											<strong>{b.label}:</strong> {b.text}
										</li>
									))}
								</ul>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="resume-block">
			<h2>Education</h2>
			<ul class="education-list">
				{
					education.map((e) => (
						<li>
							<span>
								<strong>{e.name}</strong> <em>&middot; {e.org}</em>
							</span>
							<span class="edu-dates">{e.dates}</span>
						</li>
					))
				}
			</ul>
		</section>

		<section class="resume-block">
			<h2>Languages</h2>
			<p class="languages">Native Hebrew &middot; Native English</p>
		</section>
	</div>
</section>

<style>
	.resume-page {
		max-width: 52rem;
	}

	.resume-hero {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-5);
		justify-content: space-between;
		padding: var(--space-5);
		border-radius: calc(var(--radius) * 2);
		background: var(--color-bg-subtle);
		border-top: 4px solid var(--color-accent);
	}

	.resume-hero__intro {
		flex: 1 1 24rem;
	}

	.resume-hero h1 {
		font-size: var(--text-3xl);
		margin: 0;
		line-height: 1.1;
	}

	.resume-title {
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--color-accent);
		margin: var(--space-1) 0 var(--space-3);
	}

	.resume-summary {
		max-width: 38rem;
		color: var(--color-text-muted);
		margin: 0;
	}

	.resume-hero__aside {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		flex: 0 1 16rem;
	}

	.contact-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		font-size: var(--text-sm);
	}

	.contact-list li {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.contact-list svg {
		width: 1.1rem;
		height: 1.1rem;
		flex-shrink: 0;
		color: var(--color-accent);
	}

	.contact-list a {
		color: var(--color-text);
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	.contact-list a:hover {
		color: var(--color-accent);
	}

	.download-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-weight: 600;
		font-size: var(--text-sm);
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius);
		background: var(--color-accent);
		color: var(--color-accent-contrast);
		text-decoration: none;
		text-align: center;
	}

	.download-btn:hover {
		opacity: 0.9;
	}

	.resume-body {
		margin-top: var(--space-5);
	}

	.resume-block {
		margin-top: var(--space-5);
	}

	.resume-block h2 {
		font-size: var(--text-lg);
		padding-bottom: var(--space-2);
		border-bottom: 2px solid var(--color-border);
		margin: 0 0 var(--space-4);
	}

	.skills-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: var(--space-4);
	}

	.skill-group h3 {
		font-size: var(--text-sm);
		font-weight: 600;
		margin: 0 0 var(--space-1);
	}

	.skill-group p {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		margin: 0;
	}

	.timeline {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding-left: var(--space-4);
		border-left: 2px solid var(--color-border);
	}

	.job {
		position: relative;
	}

	.job-marker {
		position: absolute;
		top: 0.4rem;
		left: calc(-1 * var(--space-4) - 5px);
		width: 9px;
		height: 9px;
		border-radius: 999px;
		background: var(--color-accent);
	}

	.job-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	.job-header h3 {
		font-size: var(--text-base);
		margin: 0;
	}

	.job-dates {
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--color-text-muted);
		background: var(--color-bg-subtle);
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		white-space: nowrap;
	}

	.job-org {
		font-size: var(--text-sm);
		color: var(--color-accent);
		font-weight: 600;
		margin: 0.1rem 0 0;
	}

	.job ul {
		margin: var(--space-2) 0 0;
		padding-left: 1.1rem;
		font-size: var(--text-sm);
	}

	.job li {
		margin: var(--space-1) 0;
	}

	.education-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		font-size: var(--text-sm);
	}

	.education-list li {
		display: flex;
		justify-content: space-between;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	.education-list em {
		color: var(--color-text-muted);
		font-style: normal;
	}

	.edu-dates {
		color: var(--color-text-muted);
		white-space: nowrap;
		font-size: var(--text-xs);
	}

	.languages {
		font-size: var(--text-sm);
		margin: 0;
	}

	@media print {
		.download-btn {
			display: none;
		}

		.resume-hero {
			border: none;
			background: none;
			padding: 0;
		}
	}
</style>
