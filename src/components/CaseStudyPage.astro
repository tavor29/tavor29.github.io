---
// Shared layout for the real-work case studies: Context / Challenge / Actions /
// Results from src/data/case-studies.ts, then the page's own artifacts (charts,
// diagrams) passed in as the default slot.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import { withBase } from '../lib/base';
import { caseStudyBySlug } from '../data/case-studies';
import { getWork } from '../data/work';
import PageCover from './cards/PageCover.astro';
import MoreWork from './cards/MoreWork.astro';
import '../styles/editorial.css';

interface Props {
	slug: string;
}

const c = caseStudyBySlug(Astro.props.slug);
const href = `case-studies/${c.slug}/`;
const item = (await getWork()).find((w) => w.href === href)!;
---

<BaseLayout title={c.org} description={c.challenge}>
	<div class="editorial">
		<div data-shape-in class="page-mark"><Icon name={c.mark} size="xl" tone="mark" /></div>
		<h1>{c.title}</h1>
		<p class="dek">Case study {c.number} · {c.role} · {c.org} · {c.years}</p>
		<PageCover item={item} />

		<section>
			<h3>Context</h3>
			<p>{c.context}</p>
		</section>

		<section>
			<h3>Challenge</h3>
			<p>{c.challenge}</p>
		</section>

		{
			c.ownership && (
				<section>
					<h3>My role</h3>
					<dl class="role">
						<div>
							<dt>I owned</dt>
							<dd>{c.ownership.mine}</dd>
						</div>
						{c.ownership.others && (
							<div>
								<dt>Others owned</dt>
								<dd>{c.ownership.others}</dd>
							</div>
						)}
						{c.ownership.scope && (
							<div>
								<dt>Scope</dt>
								<dd>{c.ownership.scope}</dd>
							</div>
						)}
					</dl>
				</section>
			)
		}

		<section>
			<h3>Actions</h3>
			<ul>
				{c.actions.map((a) => <li>{a}</li>)}
			</ul>
		</section>

		<section>
			<h3>Results</h3>
			<ul class="results">
				{
					c.results.map((r) => (
						<li>
							<strong>{r.lead}</strong> {r.text}
							{r.note && <span class="note">{r.note}</span>}
						</li>
					))
				}
			</ul>
		</section>

		{
			c.lesson && (
				<section>
					<h3>What I’d do differently</h3>
					<p>{c.lesson}</p>
				</section>
			)
		}

		<slot />

		<MoreWork href={href} />

		<p class="back">
			<a class="icon-link" href={withBase('case-studies/')}><Icon name="arrow" size="sm" class="rotate-180" />All case studies</a>
		</p>
	</div>
</BaseLayout>

<style>
	.dek {
		max-width: 42rem;
		color: var(--color-text-muted);
		margin-top: var(--space-2);
	}

	.editorial :global(section > ul) {
		padding-left: var(--space-4);
	}

	.editorial :global(section > ul > li + li) {
		margin-top: var(--space-2);
	}

	/* My role: hairline-ruled rows, a small label beside each answer. */
	.role > div {
		display: grid;
		gap: var(--space-1);
		padding: var(--space-2) 0;
		border-top: 1px solid var(--color-border);
	}

	.role > div:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.role dt {
		font-family: var(--font-label);
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: var(--tracking-label);
		color: var(--color-text-muted);
	}

	.role dd {
		margin: 0;
	}

	@media (min-width: 40rem) {
		.role > div {
			grid-template-columns: 9rem 1fr;
			gap: var(--space-3);
		}
	}

	.results .note {
		display: block;
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.back {
		margin-top: var(--space-6);
		font-size: var(--text-sm);
	}
</style>
