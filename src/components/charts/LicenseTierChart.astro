---
// Real figures from the Keshet engagement (portfolio-content-package.md, Case
// study A Part 2): "roughly 750 seats... about 680 to 690 on E5, the remainder
// on E3." Midpoint used for E5; E3 is the remainder. Scaled to a shared 750-seat
// axis. Palette: dataviz skill's validated categorical slots 1 (blue) and 2
// (orange), re-validated for this 2-color subset (node scripts/validate_palette.js).
const total = 750;
const tiers = [
	{ label: 'E5', value: 685, colorVar: '--chart-series-1' },
	{ label: 'E3', value: 65, colorVar: '--chart-series-2' },
];
---

<figure class="chart license-chart">
	<figcaption>Microsoft license tier breakdown</figcaption>
	<div class="bars">
		{
			tiers.map((tier) => (
				<div class="bar-row">
					<span class="bar-label">{tier.label}</span>
					<div class="bar-track">
						<div
							class="bar-fill"
							style={`width: ${(tier.value / total) * 100}%; background: var(${tier.colorVar});`}
						/>
					</div>
					<span class="bar-value">~{tier.value}</span>
				</div>
			))
		}
	</div>
	<p class="chart-axis-note">Out of ~{total} total seats</p>
	<p class="chart-note">Real figures from the engagement, not illustrative.</p>
</figure>

<style>
	.chart {
		margin: 0;
		max-width: 28rem;
	}

	.chart figcaption {
		font-weight: 600;
		margin-bottom: var(--space-3);
	}

	.bars {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.bar-row {
		display: grid;
		grid-template-columns: 2.5rem 1fr 3.5rem;
		align-items: center;
		gap: var(--space-2);
	}

	.bar-label {
		font-size: var(--text-sm);
		font-weight: 600;
	}

	.bar-track {
		background: var(--color-bg-subtle);
		border-radius: 999px;
		height: 1.25rem;
		overflow: hidden;
	}

	.bar-fill {
		height: 100%;
		border-radius: 999px;
	}

	.bar-value {
		font-size: var(--text-sm);
		font-variant-numeric: tabular-nums;
		text-align: right;
	}

	.chart-axis-note {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		margin: var(--space-2) 0 0;
	}

	.chart-note {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		margin: var(--space-1) 0 0;
		font-style: italic;
	}
</style>
