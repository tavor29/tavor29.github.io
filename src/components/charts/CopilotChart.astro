---
// Real figures from the Keshet engagement: "piloting Microsoft Copilot with
// around 50 users and planning to expand toward 250." Rendered as a bar
// pair against a shared axis (not a progress bar) so it reads as a chart
// alongside the license breakdown, not a number in a box.
const rows = [
	{ label: 'Pilot (current)', value: 50, style: 'filled' as const },
	{ label: 'Target', value: 250, style: 'outline' as const },
];
const max = 250;
---

<figure class="chart copilot-chart">
	<figcaption>Copilot pilot-to-target</figcaption>
	<div class="bars">
		{
			rows.map((row) => (
				<div class="bar-row">
					<span class="bar-label">{row.label}</span>
					<div class="bar-track">
						<div class={`bar-fill bar-fill--${row.style}`} style={`width: ${(row.value / max) * 100}%;`} />
					</div>
					<span class="bar-value">{row.value}</span>
				</div>
			))
		}
	</div>
	<p class="chart-axis-note">Pilot is 20% of the expansion target</p>
	<p class="chart-note">Real figures from the engagement, not illustrative.</p>
</figure>

<style>
	.chart {
		margin: 0;
		max-width: 28rem;
	}

	.chart figcaption {
		font-weight: 600;
		margin-bottom: var(--space-3);
	}

	.bars {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.bar-row {
		display: grid;
		grid-template-columns: 6.5rem 1fr 3.5rem;
		align-items: center;
		gap: var(--space-2);
	}

	.bar-label {
		font-size: var(--text-sm);
		font-weight: 600;
	}

	.bar-track {
		background: var(--color-bg-subtle);
		border-radius: 999px;
		height: 1.25rem;
		overflow: hidden;
	}

	.bar-fill {
		height: 100%;
		border-radius: 999px;
		box-sizing: border-box;
	}

	.bar-fill--filled {
		background: var(--chart-series-1);
	}

	.bar-fill--outline {
		background: transparent;
		border: 2px dashed var(--chart-series-1);
		opacity: 0.6;
	}

	.bar-value {
		font-size: var(--text-sm);
		font-variant-numeric: tabular-nums;
		text-align: right;
	}

	.chart-axis-note {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		margin: var(--space-2) 0 0;
	}

	.chart-note {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		margin: var(--space-1) 0 0;
		font-style: italic;
	}
</style>
