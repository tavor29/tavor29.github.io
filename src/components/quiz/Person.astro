---
// A flat cartoon person for the quiz illustrations (components/quiz/Scene.astro).
// Origin (x, y) is the floor under the person's feet; about 190 units tall at
// scale 1, facing right unless flip is set. Shapes only, no outlines.
import { f, s as stroke, type Colour } from './palette';

export type Pose = 'stand' | 'point' | 'present' | 'crossed' | 'think' | 'type' | 'hold' | 'shrug';
export type Mood = 'smile' | 'flat' | 'worried' | 'tired';

interface Props {
	x: number;
	y: number;
	scale?: number;
	flip?: boolean;
	sit?: boolean;
	pose?: Pose;
	mood?: Mood;
	skin?: 'skin' | 'skinDeep';
	hair?: 'short' | 'long' | 'bun' | 'curly' | 'bald';
	hairColour?: Colour;
	beard?: boolean;
	shirt?: Colour;
	pants?: Colour;
	tie?: Colour;
	cap?: Colour;
	sweat?: boolean;
}

const {
	x,
	y,
	scale = 1,
	flip = false,
	sit = false,
	pose = 'stand',
	mood = 'smile',
	skin = 'skin',
	hair = 'short',
	hairColour = 'brown',
	beard = false,
	shirt = 'blue',
	pants = 'navy',
	tie,
	cap,
	sweat = false,
} = Astro.props;

// Arms as [path, hand x, hand y], back arm then front arm. Shoulders sit at
// (-14, -132) and (14, -132).
const arms: Record<Pose, [string, number, number][]> = {
	stand: [
		['M-14 -132 L-20 -84', -20, -80],
		['M14 -132 L20 -84', 20, -80],
	],
	point: [
		['M-14 -132 L-20 -84', -20, -80],
		['M14 -132 L34 -152 L48 -178', 50, -182],
	],
	present: [
		['M-14 -132 L-20 -84', -20, -80],
		['M14 -132 L40 -126 L64 -136', 68, -137],
	],
	crossed: [
		['M-14 -132 L-18 -104 L20 -104', 24, -104],
		['M14 -132 L18 -106 L-16 -106', -18, -106],
	],
	think: [
		['M-14 -132 L-20 -84', -20, -80],
		['M14 -132 L30 -106 L18 -146', 18, -150],
	],
	type: [
		['M-14 -132 L18 -104 L42 -102', 46, -102],
		['M14 -132 L34 -106 L54 -102', 58, -102],
	],
	hold: [
		['M-14 -132 L16 -112 L38 -118', 42, -118],
		['M14 -132 L30 -110 L48 -116', 52, -116],
	],
	shrug: [
		['M-14 -132 L-34 -116 L-40 -134', -40, -138],
		['M14 -132 L34 -116 L40 -134', 40, -138],
	],
};
const [backArm, frontArm] = arms[pose];
const lift = sit ? 10 : 0;
const hairShapes = {
	short: 'M-19 -160 C-24 -186 4 -198 22 -182 C25 -178 24 -175 23 -173 C14 -180 2 -181 -4 -174 L-8 -160 Z',
	long: 'M-20 -166 C-24 -194 16 -200 23 -176 C14 -182 1 -182 -5 -174 L-5 -150 C-5 -138 -12 -128 -26 -130 C-30 -142 -24 -154 -20 -166 Z',
	bun: 'M-19 -160 C-24 -186 4 -198 22 -182 C25 -178 24 -175 23 -173 C14 -180 2 -181 -4 -174 L-8 -160 Z',
	curly: 'M-20 -158 C-30 -168 -24 -184 -14 -186 C-12 -196 2 -198 8 -192 C16 -198 28 -190 24 -178 C16 -182 4 -180 -2 -174 L-8 -158 Z',
	bald: '',
};
---

<g transform={`translate(${x} ${y}) scale(${flip ? -scale : scale} ${scale})`}>
	{
		sit ? (
			<>
				<rect x="30" y="-62" width="14" height="60" rx="6" style={f(pants)} />
				<rect x="-16" y="-68" width="62" height="16" rx="8" style={f(pants)} />
				<ellipse cx="42" cy="-3" rx="13" ry="5" style={f('ink')} />
			</>
		) : (
			<>
				<rect x="-14" y="-74" width="13" height="72" rx="6" style={f(pants)} />
				<rect x="2" y="-74" width="13" height="72" rx="6" style={f(pants)} />
				<ellipse cx="-6" cy="-3" rx="12" ry="5" style={f('ink')} />
				<ellipse cx="12" cy="-3" rx="12" ry="5" style={f('ink')} />
			</>
		)
	}
	<g transform={`translate(0 ${lift})`}>
		<rect x="-20" y="-78" width="40" height="16" rx="6" style={f(pants)} />
		<path d={backArm[0]} style={stroke(shirt, 12)} />
		<circle cx={backArm[1]} cy={backArm[2]} r="6" style={f(skin)} />
		<rect x="-23" y="-144" width="46" height="78" rx="16" style={f(shirt)} />
		{tie && <path d="M-3 -142 L3 -142 L6 -112 L0 -104 L-6 -112 Z" style={f(tie)} />}
		<rect x="-6" y="-152" width="12" height="14" rx="3" style={f(skin)} />
		{hair === 'long' && <path d={hairShapes.long} style={f(hairColour)} />}
		<circle cx="2" cy="-168" r="21" style={f(skin)} />
		{hair !== 'long' && hair !== 'bald' && <path d={hairShapes[hair]} style={f(hairColour)} />}
		{hair === 'long' && <path d="M-20 -166 C-22 -192 14 -200 23 -176 C14 -182 1 -182 -5 -174 L-8 -166 Z" style={f(hairColour)} />}
		{hair === 'bun' && <circle cx="-8" cy="-192" r="9" style={f(hairColour)} />}
		{cap && <path d="M-18 -176 C-14 -196 18 -196 22 -178 L38 -176 C38 -172 30 -171 22 -172 L-18 -172 Z" style={f(cap)} />}
		{beard && <path d="M-4 -164 C-6 -146 6 -138 15 -140 C22 -142 24 -152 23 -164 C18 -157 6 -156 -4 -164 Z" style={f(hairColour)} />}
		<circle cx="9" cy="-170" r="2.3" style={f('ink')} />
		<circle cx="18" cy="-170" r="2.3" style={f('ink')} />
		{
			mood === 'worried' && (
				<>
					<path d="M5 -176 L12 -179" style={stroke('ink', 1.8)} />
					<path d="M15 -179 L22 -176" style={stroke('ink', 1.8)} />
				</>
			)
		}
		{mood === 'tired' && <path d="M6 -173 L12 -173 M15 -173 L21 -173" style={stroke('skinDeep', 2.5)} />}
		{
			!beard &&
				(mood === 'smile' ? (
					<path d="M9 -160 Q14 -155 19 -160" style={stroke('ink', 2)} />
				) : mood === 'flat' ? (
					<path d="M10 -159 L18 -159" style={stroke('ink', 2)} />
				) : (
					<path d="M9 -157 Q14 -161 19 -157" style={stroke('ink', 2)} />
				))
		}
		{beard && mood === 'smile' && <path d="M9 -158 Q14 -154 19 -158" style={stroke('paper', 1.8)} />}
		<path d={frontArm[0]} style={stroke(shirt, 12)} />
		<circle cx={frontArm[1]} cy={frontArm[2]} r="6" style={f(skin)} />
		{sweat && <path d="M30 -190 C26 -184 26 -178 30 -177 C34 -178 34 -184 30 -190 Z" style={f('blue')} />}
	</g>
</g>
