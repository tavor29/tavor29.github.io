---
// Props for the quiz illustrations: furniture, boards and small objects in the
// same flat style as Person.astro. (x, y) is each prop's anchor, noted per kind.
import { f, s as stroke } from './palette';

export type Board = 'checklist' | 'kanban' | 'ai' | 'two-designs' | 'velocity' | 'fork' | 'budget' | 'matrix' | 'warning';

interface Props {
	kind:
		| 'desk'
		| 'chair'
		| 'laptop'
		| 'flipchart'
		| 'whiteboard'
		| 'calendar'
		| 'clock'
		| 'rack'
		| 'box'
		| 'bubble'
		| 'thought'
		| 'mug'
		| 'plant'
		| 'truck'
		| 'hourglass'
		| 'doc'
		| 'screen'
		| 'coins'
		| 'globe'
		| 'lamp';
	x: number;
	y: number;
	scale?: number;
	flip?: boolean;
	/** Desk and whiteboard width. */
	w?: number;
	/** What a board shows. */
	board?: Board;
	/** Text in a bubble, label on a clock or box. */
	text?: string;
	/** Clock hour (0-11). */
	hour?: number;
	/** Bubble points down-left instead of down-right. */
	tailLeft?: boolean;
}

const { kind, x, y, scale = 1, flip = false, w = 170, board = 'checklist', text = '', hour = 3, tailLeft = false } = Astro.props;
const t = `translate(${x} ${y}) scale(${flip ? -scale : scale} ${scale})`;
const hourAngle = (hour % 12) * 30;
const font = 'font-family:system-ui,-apple-system,Segoe UI,sans-serif;font-weight:700';
---

<g transform={t}>
	{
		kind === 'desk' && (
			// Anchor: floor, centre.
			<>
				<rect x={-w / 2} y="-84" width={w} height="9" rx="2" style={f('paper')} />
				<rect x={-w / 2 + 10} y="-76" width="6" height="76" style={f('paper')} />
				<rect x={w / 2 - 16} y="-76" width="6" height="76" style={f('paper')} />
				<rect x={w / 2 - 50} y="-76" width="40" height="30" rx="2" style={f('bgDeep')} />
			</>
		)
	}
	{
		kind === 'chair' && (
			// Anchor: floor, under the seat. Faces right.
			<>
				<rect x="-26" y="-126" width="7" height="70" rx="3" style={f('paper')} />
				<rect x="-26" y="-62" width="48" height="7" rx="3" style={f('paper')} />
				<rect x="-22" y="-56" width="5" height="56" style={f('paper')} />
				<rect x="15" y="-56" width="5" height="56" style={f('paper')} />
			</>
		)
	}
	{
		kind === 'laptop' && (
			// Anchor: desk top, centre. Screen faces left (towards a person on the left).
			<>
				<path d="M-6 -2 L4 -44 L40 -44 L30 -2 Z" style={f('navy')} />
				<circle cx="22" cy="-23" r="4" style={f('paper')} />
				<rect x="-34" y="-4" width="66" height="5" rx="2" style={f('ink')} />
			</>
		)
	}
	{
		kind === 'flipchart' && (
			// Anchor: floor, centre. Board face 120 x 150.
			<>
				<path d="M0 -110 L-30 0 M0 -110 L30 0 M0 -110 L0 -20" style={stroke('navy', 5)} />
				<rect x="-64" y="-262" width="128" height="12" rx="3" style={f('navy')} />
				<rect x="-60" y="-252" width="120" height="150" style={f('paper')} />
			</>
		)
	}
	{
		kind === 'whiteboard' && (
			// Anchor: top-left corner, on the wall.
			<>
				<rect x="-6" y="-6" width={w + 12} height="132" rx="4" style={f('bgDeep')} />
				<rect x="0" y="0" width={w} height="120" rx="2" style={f('paper')} />
				<rect x={w * 0.1} y="118" width={w * 0.8} height="6" rx="3" style={f('navy')} />
			</>
		)
	}
	{
		(kind === 'flipchart' || kind === 'whiteboard') && (
			<g transform={kind === 'flipchart' ? 'translate(0 -177)' : `translate(${w / 2} 60)`}>
				{board === 'checklist' && (
					<>
						{[-48, -18, 12].map((yy) => (
							<>
								<rect x="-42" y={yy} width="16" height="16" rx="3" style={f('green')} />
								<path d={`M-38 ${yy + 8} L-34 ${yy + 12} L-29 ${yy + 4}`} style={stroke('paper', 2.5)} />
								<rect x="-18" y={yy + 4} width="58" height="8" rx="4" style={f('bgDeep')} />
							</>
						))}
						<rect x="-42" y="42" width="16" height="16" rx="3" style={f('alert')} />
						<path d="M-34 45 L-34 55 M-39 50 L-29 50" style={stroke('paper', 2.5)} />
						<rect x="-18" y="46" width="58" height="8" rx="4" style={f('alert')} />
					</>
				)}
				{board === 'kanban' && (
					<>
						{[-1, 0, 1].map((col) => (
							<rect x={col * 70 - 32} y="-50" width="64" height="8" rx="4" style={f('navy')} />
						))}
						<rect x="-102" y="-34" width="34" height="24" rx="2" style={f('amber')} />
						<rect x="-62" y="-34" width="28" height="24" rx="2" style={f('amber')} />
						<rect x="-102" y="-4" width="34" height="24" rx="2" style={f('blue')} />
						<rect x="-32" y="-34" width="34" height="24" rx="2" style={f('blue')} />
						<rect x="8" y="-34" width="26" height="24" rx="2" style={f('amber')} />
						<rect x="38" y="-34" width="34" height="24" rx="2" style={f('green')} />
						<rect x="38" y="-4" width="34" height="24" rx="2" style={f('green')} />
						<rect x="-32" y="-4" width="34" height="24" rx="2" style={f('alert')} transform="rotate(-8 -15 8)" />
					</>
				)}
				{board === 'ai' && (
					<>
						<rect x="-40" y="-40" width="80" height="54" rx="12" style={f('blue')} />
						<path d="M-18 14 L-26 32 L0 14 Z" style={f('blue')} />
						<text x="0" y="-4" text-anchor="middle" style={`${font};font-size:26px;fill:var(--color-paper)`}>AI</text>
						<rect x="-40" y="42" width="80" height="8" rx="4" style={f('bgDeep')} />
					</>
				)}
				{board === 'two-designs' && (
					<>
						<rect x="-82" y="-44" width="30" height="20" rx="3" style={f('blue')} />
						<rect x="-100" y="0" width="26" height="18" rx="3" style={f('blue')} />
						<rect x="-60" y="0" width="26" height="18" rx="3" style={f('blue')} />
						<path d="M-67 -24 L-87 0 M-67 -24 L-47 0" style={stroke('navy', 2.5)} />
						<path d="M0 -50 L0 50" style={stroke('bgDeep', 3)} />
						<rect x="38" y="-48" width="30" height="18" rx="3" style={f('orange')} />
						<rect x="38" y="-12" width="30" height="18" rx="3" style={f('orange')} />
						<rect x="38" y="24" width="30" height="18" rx="3" style={f('orange')} />
						<path d="M53 -30 L53 -12 M53 6 L53 24" style={stroke('navy', 2.5)} />
					</>
				)}
				{board === 'velocity' && (
					<>
						<path d="M-44 -48 L-44 48 L48 48" style={stroke('navy', 3)} />
						{[0, 1, 2, 3, 4].map((i) => (
							<rect x={-34 + i * 17} y={48 - [80, 74, 56, 40, 26][i]} width="11" height={[80, 74, 56, 40, 26][i]} rx="2" style={f(i < 2 ? 'blue' : 'alert')} />
						))}
					</>
				)}
				{board === 'fork' && (
					<>
						<rect x="-16" y="-50" width="32" height="26" rx="3" style={f('amber')} />
						<text x="0" y="-31" text-anchor="middle" style={`${font};font-size:18px;fill:var(--color-ink)`}>?</text>
						<path d="M0 -24 L0 -8 L-30 10 M0 -8 L30 10" style={stroke('navy', 3)} />
						<rect x="-44" y="14" width="26" height="22" rx="3" style={f('green')} />
						<rect x="14" y="14" width="40" height="38" rx="3" style={f('alert')} />
					</>
				)}
				{board === 'budget' && (
					<>
						<text x="-46" y="-30" style={`${font};font-size:11px;fill:var(--color-ink)`}>SPENT</text>
						<rect x="-46" y="-24" width="92" height="14" rx="3" style={f('bgDeep')} />
						<rect x="-46" y="-24" width="55" height="14" rx="3" style={f('orange')} />
						<text x="-46" y="12" style={`${font};font-size:11px;fill:var(--color-ink)`}>DONE</text>
						<rect x="-46" y="18" width="92" height="14" rx="3" style={f('bgDeep')} />
						<rect x="-46" y="18" width="41" height="14" rx="3" style={f('green')} />
						<path d="M9 -32 L9 42" style={stroke('alert', 2)} />
					</>
				)}
				{board === 'matrix' && (
					<>
						{[-1, 0, 1].map((col) =>
							[-1, 0, 1].map((row) => <circle cx={col * 36} cy={row * 32} r="9" style={f(col === 0 && row === 0 ? 'amber' : 'bgDeep')} />),
						)}
						<path d="M8 0 C20 -16 28 -16 36 -10" style={stroke('alert', 3)} />
						<path d="M30 -16 L37 -9 L28 -6" style={stroke('alert', 3)} />
						<rect x="-60" y="-56" width="120" height="8" rx="4" style={f('navy')} />
					</>
				)}
				{board === 'warning' && (
					<>
						<path d="M0 -46 L44 32 L-44 32 Z" style={f('alert')} />
						<rect x="-3.5" y="-20" width="7" height="30" rx="3" style={f('paper')} />
						<circle cx="0" cy="20" r="4" style={f('paper')} />
					</>
				)}
			</g>
		)
	}
	{
		kind === 'calendar' && (
			// Anchor: top-left, on the wall.
			<>
				<rect x="0" y="0" width="70" height="74" rx="4" style={f('paper')} />
				<rect x="0" y="0" width="70" height="18" rx="4" style={f('alert')} />
				<rect x="0" y="12" width="70" height="6" style={f('alert')} />
				{[0, 1, 2, 3].map((r) =>
					[0, 1, 2, 3, 4].map((col) => <rect x={8 + col * 12} y={26 + r * 11} width="7" height="6" rx="1" style={f('bgDeep')} />),
				)}
				<circle cx="35.5" cy="51" r="8" style={stroke('alert', 2.5)} />
			</>
		)
	}
	{
		kind === 'clock' && (
			// Anchor: centre.
			<>
				<circle r="24" style={f('paper')} />
				<circle r="24" style={stroke('navy', 3)} />
				<path d="M0 0 L0 -16" transform={`rotate(${hourAngle})`} style={stroke('navy', 3)} />
				<path d="M0 0 L0 -12" transform="rotate(180)" style={stroke('navy', 2)} />
				{text && (
					<text y="42" text-anchor="middle" style={`${font};font-size:12px;fill:var(--illo-navy)`}>
						{text}
					</text>
				)}
			</>
		)
	}
	{
		kind === 'rack' && (
			// Anchor: floor, centre.
			<>
				<rect x="-34" y="-190" width="68" height="190" rx="4" style={f('navy')} />
				{[0, 1, 2, 3, 4, 5].map((i) => (
					<>
						<rect x="-26" y={-180 + i * 28} width="52" height="20" rx="2" style={f(i === 2 || i === 3 ? 'bgDeep' : 'ink')} />
						{i !== 2 && i !== 3 && <circle cx="18" cy={-170 + i * 28} r="3" style={f(i % 2 ? 'green' : 'amber')} />}
					</>
				))}
			</>
		)
	}
	{
		kind === 'box' && (
			// Anchor: bottom centre.
			<>
				<rect x="-32" y="-46" width="64" height="46" rx="3" style={f('orange')} />
				<rect x="-32" y="-46" width="64" height="10" rx="3" style={f('amber')} />
				<rect x="-6" y="-46" width="12" height="46" style={f('amber')} />
				{text && (
					<text x="0" y="-12" text-anchor="middle" style={`${font};font-size:11px;fill:var(--illo-navy)`}>
						{text}
					</text>
				)}
			</>
		)
	}
	{
		kind === 'bubble' && (
			// Anchor: the tip of the tail.
			<>
				<path d={tailLeft ? 'M0 0 L4 -22 L22 -22 Z' : 'M0 0 L-4 -22 L-22 -22 Z'} style={f('paper')} />
				<rect x={tailLeft ? -10 : -Math.max(54, text.length * 11 + 22) + 10} y="-62" width={Math.max(54, text.length * 11 + 22)} height="42" rx="14" style={f('paper')} />
				<text
					x={tailLeft ? -10 + Math.max(54, text.length * 11 + 22) / 2 : 10 - Math.max(54, text.length * 11 + 22) / 2}
					y="-34"
					text-anchor="middle"
					style={`${font};font-size:18px;fill:var(--illo-navy)`}
				>
					{text}
				</text>
			</>
		)
	}
	{
		kind === 'thought' && (
			// Anchor: the smallest dot; the cloud sits up and to the right and holds the slot.
			<>
				<circle cx="0" cy="0" r="4" style={f('paper')} />
				<circle cx="12" cy="-12" r="7" style={f('paper')} />
				<ellipse cx="80" cy="-48" rx="78" ry="50" style={f('paper')} />
				<g transform="translate(80 -48)">
					<slot />
				</g>
			</>
		)
	}
	{
		kind === 'mug' && (
			// Anchor: bottom centre.
			<>
				<rect x="-8" y="-18" width="16" height="18" rx="3" style={f('alert')} />
				<path d="M8 -14 C14 -14 14 -5 8 -5" style={stroke('alert', 3)} />
				<path d="M-3 -24 C-6 -28 0 -30 -3 -34 M3 -24 C0 -28 6 -30 3 -34" style={stroke('paper', 2)} />
			</>
		)
	}
	{
		kind === 'plant' && (
			// Anchor: floor, centre.
			<>
				<path d="M0 -40 C-30 -60 -26 -96 -6 -110 C-4 -80 -2 -60 0 -40 Z" style={f('green')} />
				<path d="M0 -40 C24 -56 30 -90 14 -104 C6 -78 2 -60 0 -40 Z" style={f('green')} />
				<path d="M-18 -40 L18 -40 L13 0 L-13 0 Z" style={f('orange')} />
			</>
		)
	}
	{
		kind === 'truck' && (
			// Anchor: ground, centre. Drives right.
			<>
				<rect x="-50" y="-48" width="64" height="38" rx="3" style={f('orange')} />
				<path d="M14 -36 L36 -36 L48 -22 L48 -10 L14 -10 Z" style={f('blue')} />
				<path d="M20 -32 L34 -32 L42 -22 L20 -22 Z" style={f('paper')} />
				<circle cx="-30" cy="-8" r="9" style={f('ink')} />
				<circle cx="30" cy="-8" r="9" style={f('ink')} />
				{text && (
					<text x="-18" y="-24" text-anchor="middle" style={`${font};font-size:13px;fill:var(--color-paper)`}>
						{text}
					</text>
				)}
			</>
		)
	}
	{
		kind === 'hourglass' && (
			// Anchor: bottom centre.
			<>
				<rect x="-18" y="-60" width="36" height="6" rx="2" style={f('navy')} />
				<rect x="-18" y="-6" width="36" height="6" rx="2" style={f('navy')} />
				<path d="M-13 -54 L13 -54 L2 -31 L13 -6 L-13 -6 L-2 -31 Z" style={f('paper')} />
				<path d="M-8 -48 L8 -48 L1 -34 L-1 -34 Z M-10 -8 L10 -8 L0 -20 Z" style={f('amber')} />
			</>
		)
	}
	{
		kind === 'doc' && (
			// Anchor: centre.
			<>
				<rect x="-22" y="-28" width="44" height="56" rx="3" style={f('paper')} />
				{[-16, -6, 4].map((yy) => (
					<rect x="-14" y={yy} width="28" height="4" rx="2" style={f('bgDeep')} />
				))}
				<circle cx="12" cy="18" r="10" style={f('green')} />
				<path d="M7 18 L11 22 L17 14" style={stroke('paper', 2.5)} />
			</>
		)
	}
	{
		kind === 'screen' && (
			// Anchor: top-left, on the wall. A video-call screen with a face in it.
			<>
				<rect x="0" y="0" width="110" height="74" rx="5" style={f('navy')} />
				<rect x="6" y="6" width="98" height="62" rx="2" style={f('bgDeep')} />
				<path d="M30 68 C30 50 80 50 80 68 Z" style={f(text === 'b' ? 'orange' : 'purple')} />
				<circle cx="55" cy="34" r="13" style={f(text === 'b' ? 'skinDeep' : 'skin')} />
				<path
					d={text === 'b' ? 'M42 32 C40 16 70 16 68 32 C62 26 50 26 42 32 Z' : 'M41 36 C38 14 72 14 69 36 L66 30 C60 24 50 24 44 30 Z'}
					style={f(text === 'b' ? 'ink' : 'red')}
				/>
				<rect x="40" y="74" width="30" height="8" style={f('navy')} />
			</>
		)
	}
	{
		kind === 'coins' && (
			// Anchor: bottom centre.
			<>
				{[0, 1, 2, 3].map((i) => (
					<ellipse cx="0" cy={-5 - i * 7} rx="16" ry="6" style={f(i % 2 ? 'amber' : 'orange')} />
				))}
			</>
		)
	}
	{
		kind === 'globe' && (
			// Anchor: centre.
			<>
				<circle r="30" style={f('blue')} />
				<path d="M-20 -14 C-10 -22 4 -16 0 -6 C-6 4 -18 0 -22 -6 Z M6 6 C16 2 24 10 18 20 C12 26 4 18 6 6 Z" style={f('green')} />
			</>
		)
	}
	{
		kind === 'lamp' && (
			// Anchor: ceiling point.
			<>
				<path d="M0 0 L0 40" style={stroke('navy', 3)} />
				<path d="M-22 60 C-22 44 22 44 22 60 Z" style={f('navy')} />
				<ellipse cx="0" cy="60" rx="8" ry="3" style={f('amber')} />
			</>
		)
	}
</g>
