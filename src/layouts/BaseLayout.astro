---
import '../styles/tokens.css';
import { withBase } from '../lib/base';

interface Props {
	title?: string;
}

const { title = 'Tavor Ben Shahar' } = Astro.props;

// Open Source & Tools (Block 7) is deliberately hidden from nav until it's
// built, see CLAUDE.md's Ground truth. The route/page still exists, just unlinked.
const navLinks = [
	{ href: withBase(''), label: 'Home' },
	{ href: withBase('projects/'), label: 'Projects' },
	{ href: withBase('case-studies/'), label: 'Case Studies' },
	{ href: withBase('blog/'), label: 'Blog' },
];

const currentPath = Astro.url.pathname;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
		<link rel="icon" href={withBase('favicon.ico')} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title === 'Tavor Ben Shahar' ? title : `${title} — Tavor Ben Shahar`}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="wrap site-header__row">
				<a href={withBase('')} class="wordmark">Tavor Ben Shahar</a>
				<nav aria-label="Main">
					<ul class="nav-list">
						{
							navLinks.map((link) => (
								<li>
									<a
										href={link.href}
										aria-current={currentPath === link.href ? 'page' : undefined}
									>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</header>

		<main class="wrap">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap site-footer__row">
				<p>&copy; {new Date().getFullYear()} Tavor Ben Shahar</p>
				<a href={withBase('Tavor_Ben_Shahar_Resume.pdf')}>Resume (PDF)</a>
			</div>
		</footer>
	</body>
</html>

<style>
	.wrap {
		max-width: var(--max-width);
		margin-inline: auto;
		padding-inline: var(--space-3);
	}

	.site-header {
		border-bottom: 1px solid var(--color-border);
	}

	.site-header__row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		padding-block: var(--space-3);
	}

	.wordmark {
		font-weight: 700;
		font-size: var(--text-lg);
		color: var(--color-text);
		text-decoration: none;
	}

	.nav-list {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin: 0;
		padding: 0;
	}

	.nav-list a {
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: var(--text-sm);
	}

	.nav-list a:hover,
	.nav-list a[aria-current='page'] {
		color: var(--color-accent);
	}

	main {
		min-height: 60vh;
		padding-block: var(--space-5);
	}

	.site-footer {
		border-top: 1px solid var(--color-border);
		background: var(--color-bg-subtle);
	}

	.site-footer__row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		padding-block: var(--space-4);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.site-footer__row p {
		margin: 0;
	}
</style>
