---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { withBase } from '../lib/base';
import { person } from '../data/home';

interface Props {
	title?: string;
	description?: string;
	/** Homepage: full-bleed sections that manage their own width and spacing. */
	bare?: boolean;
}

const {
	title = person.name,
	description = 'Business Operations & Program Manager leading technology programs across R&D, IT, Security, and Finance: AI governance, technical program delivery, and enterprise infrastructure.',
	bare = false,
} = Astro.props;

// Open Source & Tools (Block 7) is deliberately hidden from nav until it's
// built, see CLAUDE.md's Ground truth. The route/page still exists, just unlinked.
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
		<link rel="icon" type="image/png" sizes="32x32" href={withBase('favicon.png')} />
		<title>{title === person.name ? `${person.name}, ${person.role}` : `${title} | ${person.name}`}</title>
		<!-- Lets CSS hide reveal targets before GSAP runs, without hiding them for no-JS visitors. -->
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		<SiteNav />
		{
			bare ? (
				<main>
					<slot />
				</main>
			) : (
				<main class="wrap">
					<slot />
				</main>
			)
		}
		<SiteFooter />
		<script>
			import '../scripts/motion';
		</script>
	</body>
</html>

<style>
	/* Long-read pages: same column and gutters as the homepage and footer
	   (components/ui/Container.astro), pushed below the fixed nav. */
	.wrap {
		box-sizing: content-box;
		max-width: var(--container);
		margin-inline: auto;
		padding-inline: var(--space-gutter);
		padding-top: var(--space-section);
		min-height: 60vh;
	}

	@media (min-width: 768px) {
		.wrap {
			padding-inline: var(--space-stack);
		}
	}

	@media print {
		:global(header[data-ui]),
		:global(footer[data-ui]) {
			display: none !important;
		}

		.wrap {
			padding-top: 0;
			min-height: 0;
		}
	}
</style>
